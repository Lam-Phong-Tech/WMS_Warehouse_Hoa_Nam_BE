APP_NAME=WMS_HoaNam
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wms_hoanam
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# Tiền tố cache Redis/Valkey ở tầng store (Laravel cache.prefix). Nếu nhiều môi trường
# (dev/uat/production) dùng CHUNG 1 Valkey instance, mỗi môi trường PHẢI set giá trị
# khác nhau để tránh đụng độ key (vd: wms-dev-cache-, wms-uat-cache-, wms-production-cache-).
# Mặc định dưới đây tự suy ra từ APP_ENV. Đổi giá trị này ở môi trường đã có cache data
# là thay đổi cần document — dữ liệu cache cũ dưới prefix trước sẽ "mồ côi" và tự hết
# hạn theo TTL, không mất dữ liệu nghiệp vụ (PostgreSQL vẫn là source of truth) nhưng
# cache sẽ nguội lại từ đầu, cần cân nhắc thời điểm đổi (mục 20).
CACHE_PREFIX=wms-${APP_ENV}-cache-

# TTL (giây) theo domain — policy tập trung tại config/wms_cache.php, đọc qua
# App\Support\Cache\CacheTtl. Guideline mặc định cho tải vừa; tinh chỉnh theo môi trường
# thực tế, không hard-code TTL rải rác trong code (mục 17).
CACHE_TTL_RBAC=300
CACHE_TTL_MASTER=1800
CACHE_TTL_REFERENCE=3600
CACHE_TTL_SKU=900
CACHE_TTL_SEARCH=120
CACHE_TTL_DASHBOARD=60
CACHE_TTL_REPORT=300
CACHE_TTL_STOCK_SHORT=20
# +/- % TTL ngẫu nhiên quanh giá trị gốc để tránh nhiều key hết hạn cùng lúc.
CACHE_TTL_JITTER_PERCENT=10
# Cache::lock() cho stampede protection trên hot key (master list/report/dashboard).
CACHE_LOCK_WAIT_SECONDS=5
CACHE_LOCK_TTL_SECONDS=10
# true: application cache tự fallback xuống DB khi Valkey lỗi/không kết nối được thay
# vì làm hỏng response (không áp dụng cho session/queue).
CACHE_FAIL_OPEN=true

# Valkey (Redis-compatible), qua client predis/predis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# DB 0 cho session/queue (mặc định Laravel connection 'default'), DB 1 riêng cho
# application cache (config/database.php redis.cache.database) — cô lập để lệnh clear
# application cache không bao giờ đụng session/queue (mục 20/28).
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@wms-hoanam.local"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO (local dev) / S3-compatible (production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
VITE_APP_ENV="${APP_ENV}"
VITE_API_BASE_URL="${APP_URL}/api/v1"
VITE_HEALTH_ENDPOINT="${APP_URL}/api/health"
VITE_BUILD_VERSION=local-dev
VITE_BUILD_SHA=local

JWT_SECRET=
JWT_TTL=60
REFRESH_TOKEN_TTL_MINUTES=20160

# Browser refresh-session cookie. Access JWT remains memory-only on FE.
REFRESH_TOKEN_COOKIE_NAME=wms_refresh_token
REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth
REFRESH_TOKEN_COOKIE_DOMAIN=
# Local/testing HTTP may be false. Non-local environments force Secure=true in
# config even if a stale deployment env accidentally keeps this value false.
REFRESH_TOKEN_COOKIE_SECURE=false
# Use lax for same-site FE/API. "none" automatically forces Secure=true.
REFRESH_TOKEN_COOKIE_SAME_SITE=lax

# Audit: outbox_required | fail_closed | best_effort
# WWHN-172 mutation routes tự ép fail_closed theo request.
AUDIT_WRITE_POLICY=outbox_required
AUDIT_RECONCILE_BATCH_SIZE=200
AUDIT_RECONCILE_MAX_BACKOFF_MINUTES=60

# OpenAPI source-of-truth theo môi trường deploy
L5_SWAGGER_CONST_HOST="${APP_URL}"
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_GENERATE_YAML_COPY=true
L5_FORMAT_TO_USE_FOR_DOCS=json

# Browser CORS. Comma-separated exact origins; production/UAT must override this
# with the deployed FE origin(s). Credentialed CORS is a protocol invariant for
# the HttpOnly refresh cookie and is always enabled by config; no wildcard origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UAT_SEED_PASSWORD=
