APP_NAME=WMS_HoaNam
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wms_hoanam
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=wms

# Valkey (Redis-compatible), qua client predis/predis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@wms-hoanam.local"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO (local dev) / S3-compatible (production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
VITE_APP_ENV="${APP_ENV}"
VITE_API_BASE_URL="${APP_URL}/api/v1"
VITE_HEALTH_ENDPOINT="${APP_URL}/api/health"
VITE_BUILD_VERSION=local-dev
VITE_BUILD_SHA=local

JWT_SECRET=
JWT_TTL=60
REFRESH_TOKEN_TTL_MINUTES=20160

# Audit: outbox_required | fail_closed | best_effort
# WWHN-172 mutation routes tự ép fail_closed theo request.
AUDIT_WRITE_POLICY=outbox_required
AUDIT_RECONCILE_BATCH_SIZE=200
AUDIT_RECONCILE_MAX_BACKOFF_MINUTES=60

# OpenAPI source-of-truth theo môi trường deploy
L5_SWAGGER_CONST_HOST="${APP_URL}"
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_GENERATE_YAML_COPY=true
L5_FORMAT_TO_USE_FOR_DOCS=json

CORS_ALLOWED_ORIGINS=
