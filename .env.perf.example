# ===========================================================================
# HỒ SƠ CHỊU TẢI — biến môi trường cho docker-compose.perf.yml
#
# CÁCH DÙNG
#   1. Chọn một preset bên dưới, chép các dòng của nó vào CUỐI file `.env`
#      (docker compose đọc `.env` ở thư mục gốc để nội suy biến).
#   2. Khởi động kèm overlay:
#        docker compose -f docker-compose.yml -f docker-compose.override.yml \
#                       -f docker-compose.perf.yml up -d --build
#
# KHÔNG chép cả file này đè lên `.env` — nó chỉ chứa tham số vận hành, không có
# APP_KEY/JWT_SECRET/DB_PASSWORD.
#
# Mọi giá trị ở đây đều đã có mặc định an toàn trong docker-compose.perf.yml;
# file này chỉ để ghi đè khi máy thật khác preset.
# ===========================================================================


# ---------------------------------------------------------------------------
# CÁCH TÍNH KÍCH THƯỚC — đọc một lần rồi áp cho mọi máy
# ---------------------------------------------------------------------------
#
# 1) PHP_FPM_MAX_CHILDREN — trần số request PHP chạy ĐỒNG THỜI.
#
#      PHP_FPM_MAX_CHILDREN = (RAM dành cho backend) / (RAM một worker)
#
#    Một worker Laravel của dự án này chiếm ~45-55MB khi opcache đã nóng. Đặt
#    cao hơn RAM cho phép không làm hệ thống nhanh hơn — nó đổi lỗi "hết kết
#    nối" (nhìn thấy được, xếp hàng được) lấy lỗi OOM-kill (mất trắng request
#    đang xử lý). Luôn tính từ RAM THẬT.
#
#    Trần thứ hai là CPU: phần việc thực sự tốn CPU vẫn chỉ chạy song song được
#    bằng số lõi. Nhiều worker hơn số lõi chỉ giúp lấp thời gian chờ I/O (đợi
#    Postgres, Redis, S3) — có ích, nhưng không nhân đôi thông lượng.
#
# 2) PG_MAX_CONNECTIONS phải LỚN HƠN tổng số tiến trình PHP có thể mở kết nối:
#
#      PG_MAX_CONNECTIONS >= PHP_FPM_MAX_CHILDREN
#                          + (QUEUE_REPLICAS * 1)
#                          + 1 (scheduler) + 1 (reverb)
#                          + 10 (dự phòng cho psql/migrate/backup)
#
#    Thiếu là gặp "FATAL: sorry, too many clients already" -> 500 về người dùng.
#
# 3) Ngân sách RAM tổng phải NHỎ HƠN RAM máy (hoặc RAM cấp cho Docker Desktop):
#
#      BACKEND_MEM_LIMIT + QUEUE_REPLICAS*QUEUE_MEM_LIMIT + REVERB_MEM_LIMIT
#      + SCHEDULER_MEM_LIMIT + PG_MEM_LIMIT + VALKEY_MEM_LIMIT
#      + ~500m (nginx + minio + mailpit) + ~1G (hệ điều hành/Docker)
#
# ---------------------------------------------------------------------------


# ===========================================================================
# PRESET A — máy dev hiện tại: Docker Desktop 16 vCPU / 8GB RAM
# (đây cũng là MẶC ĐỊNH đã ghi trong docker-compose.perf.yml, chép ra đây để
# thấy rõ con số; chỉ cần chép nếu muốn chỉnh)
# ===========================================================================
# PHP_FPM_MAX_CHILDREN=48
# PHP_FPM_START_SERVERS=12
# PHP_FPM_MIN_SPARE=12
# PHP_FPM_MAX_SPARE=24
# BACKEND_MEM_LIMIT=2600m
# BACKEND_CPU_LIMIT=10
# QUEUE_REPLICAS=2
# QUEUE_MEM_LIMIT=300m
# REVERB_MEM_LIMIT=512m
# SCHEDULER_MEM_LIMIT=200m
# PG_MAX_CONNECTIONS=120
# PG_SHARED_BUFFERS=512MB
# PG_EFFECTIVE_CACHE_SIZE=1536MB
# PG_MEM_LIMIT=1600m
# VALKEY_MAXMEMORY=256mb
# VALKEY_MEM_LIMIT=400m
#
# Trần thực tế của preset này: xem docs/perf/LOAD_TEST_REPORT.md. Máy dev còn
# phải nuôi cả trình sinh tải k6, nên đây KHÔNG phải con số của server thật.


# ===========================================================================
# PRESET B — server thật cỡ vừa: 8 vCPU / 16GB RAM
# Mục tiêu ~3000 người dùng đồng thời có think-time (~375 request/giây).
# ===========================================================================
# PHP_FPM_MAX_CHILDREN=120
# PHP_FPM_START_SERVERS=30
# PHP_FPM_MIN_SPARE=24
# PHP_FPM_MAX_SPARE=60
# BACKEND_MEM_LIMIT=7000m
# BACKEND_CPU_LIMIT=5
# QUEUE_REPLICAS=3
# QUEUE_MEM_LIMIT=400m
# REVERB_MEM_LIMIT=1024m
# REVERB_MEMORY_LIMIT=768M
# SCHEDULER_MEM_LIMIT=256m
# PG_MAX_CONNECTIONS=200
# PG_SHARED_BUFFERS=4GB
# PG_EFFECTIVE_CACHE_SIZE=11GB
# PG_WORK_MEM=12MB
# PG_MAINTENANCE_WORK_MEM=512MB
# PG_MEM_LIMIT=5500m
# PG_SHM_SIZE=1gb
# VALKEY_MAXMEMORY=1gb
# VALKEY_MEM_LIMIT=1300m


# ===========================================================================
# PRESET C — server thật cỡ lớn: 16 vCPU / 32GB RAM
# Dư địa cho 3000 người dùng kể cả lúc cao điểm và lúc chạy báo cáo nặng.
# ===========================================================================
# PHP_FPM_MAX_CHILDREN=250
# PHP_FPM_START_SERVERS=60
# PHP_FPM_MIN_SPARE=40
# PHP_FPM_MAX_SPARE=120
# BACKEND_MEM_LIMIT=14g
# BACKEND_CPU_LIMIT=11
# QUEUE_REPLICAS=4
# QUEUE_MEM_LIMIT=512m
# REVERB_MEM_LIMIT=2g
# REVERB_MEMORY_LIMIT=1536M
# SCHEDULER_MEM_LIMIT=512m
# PG_MAX_CONNECTIONS=350
# PG_SHARED_BUFFERS=8GB
# PG_EFFECTIVE_CACHE_SIZE=22GB
# PG_WORK_MEM=16MB
# PG_MAINTENANCE_WORK_MEM=1GB
# PG_MAX_WAL_SIZE=8GB
# PG_MEM_LIMIT=12g
# PG_SHM_SIZE=2gb
# VALKEY_MAXMEMORY=2gb
# VALKEY_MEM_LIMIT=2600m


# ===========================================================================
# MỞ RỘNG NGANG (nhiều máy chạy backend)
# ===========================================================================
# Khi một máy đã hết dư địa, cách tăng tiếp là thêm máy chạy php-fpm rồi khai
# báo chúng cho nginx. Chuỗi này được chèn nguyên văn vào khối `upstream`:
#
# WMS_PHP_UPSTREAM_SERVERS=server backend:9000 max_fails=3 fail_timeout=10s; server 10.0.0.12:9000 max_fails=3 fail_timeout=10s; server 10.0.0.13:9000 max_fails=3 fail_timeout=10s;
#
# Điều kiện bắt buộc khi có nhiều máy: session/cache/queue PHẢI dùng chung một
# Valkey/Redis (dự án đã đúng: SESSION_DRIVER=redis, CACHE_STORE=redis,
# QUEUE_CONNECTION=redis) và file tải lên phải nằm trên S3/MinIO chứ không phải
# đĩa cục bộ (dự án đã đúng: FILESYSTEM_DISK=s3).


# ===========================================================================
# CƠ SỞ DỮ LIỆU DÙNG KHI ĐO TẢI
# ===========================================================================
# Trỏ stack sang một bản sao có khối lượng dữ liệu lớn để đo cho sát thực tế mà
# không đụng vào dữ liệu đang dùng. Bỏ trống thì dùng đúng DB thật.
# PERF_DB_DATABASE=wms_hoanam_perf


# ===========================================================================
# HẠ NGƯỠNG CHỐNG LẠM DỤNG KHI ĐO TẢI (config/rate_limit.php: 0 = tắt guard)
# ===========================================================================
# k6 phát toàn bộ tải từ MỘT địa chỉ IP, nên các guard khoá theo IP sẽ trả 429
# hàng loạt và làm hỏng phép đo — 429 không phải lỗi hệ thống, nhưng cũng không
# phải kết quả cần đo. CHỈ đặt trên môi trường đo tải, TUYỆT ĐỐI không deploy.
# RATE_LIMIT_PUBLIC_API_PER_MINUTE=0
# RATE_LIMIT_PV_PUBLIC_PER_MINUTE=0
# RATE_LIMIT_AUTH_REFRESH_PER_MINUTE=0


# ===========================================================================
# GHI CHÚ VỀ CÁC GIÁ TRỊ TRONG .env HIỆN TẠI CẦN SỬA TRƯỚC KHI CHẠY THẬT
# ===========================================================================
# - APP_DEBUG=true       -> overlay đã ép về false cho container, nhưng file
#                           `.env` khi deploy thật vẫn phải sửa.
# - LOG_LEVEL=debug      -> ghi mọi truy vấn ra đĩa; overlay ép về warning.
# - JWT_TTL=43200        -> 30 ngày, đang để tạm cho việc quét scanner. Đặt lại
#                           60 trước khi chạy thật (ghi chú đã có sẵn trong .env).
# - BCRYPT_ROUNDS=12     -> mỗi lần đăng nhập tốn ~200-300ms CPU. Ở đợt đăng
#                           nhập đầu ca của 3000 người, đây là khoản CPU lớn
#                           nhất trong toàn hệ thống. Giá trị 10 vẫn nằm trong
#                           khuyến nghị hiện hành và rẻ hơn khoảng 4 lần.
#                           ĐỔI GIÁ TRỊ NÀY KHÔNG LÀM HỎNG MẬT KHẨU CŨ: hash cũ
#                           tự mang theo số vòng của nó, chỉ hash MỚI dùng giá
#                           trị mới.
# BCRYPT_ROUNDS=10
