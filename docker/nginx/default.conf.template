# WWHN-295: nginx là proxy trong cùng đứng trước php-fpm. Với FastCGI, nginx tự
# chuyển header client thành HTTP_*; nhưng khi nginx là proxy ĐẦU TIÊN thì không
# có X-Forwarded-* nào cả, nên PHP chỉ thấy REMOTE_ADDR = IP container nginx.
# Ba map dưới đây giữ nguyên giá trị do TLS terminator bên ngoài gửi (nếu có) và
# chỉ sinh giá trị thay thế khi header trống. fastcgi_param khai báo tường minh
# ghi đè header tự động cùng tên, nên client không tự bịa được các giá trị này.
map $http_x_forwarded_proto $wms_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

map $http_x_forwarded_host $wms_forwarded_host {
    default $http_x_forwarded_host;
    ""      $host;
}

# WWHN-295 follow-up: $server_port is nginx's internal listen port (80), not
# the host-mapped port the browser actually used (NGINX_DOCKER_PORT, default
# 8080). Falling back to $server_port made every self-referential URL Laravel
# generates (L5-Swagger docs.json, asset links) drop the port when no client
# sent X-Forwarded-Port — the case for plain local Docker access with no
# external TLS terminator in front. Fall back to the real external port
# instead, substituted at container start from NGINX_DOCKER_PORT.
map $http_x_forwarded_port $wms_forwarded_port {
    default $http_x_forwarded_port;
    ""      "${WMS_NGINX_EXTERNAL_PORT}";
}

# ---------------------------------------------------------------------------
# LỖI GATEWAY ĐỌC ĐƯỢC KHI BACKEND CHƯA SẴN SÀNG (10/09/2026)
#
# Mỗi lần container `backend` được tạo lại / khởi động lại (`docker compose up
# -d`, `restart`, Docker Desktop bật lại) có ~10–25 giây php-fpm chưa nghe cổng
# 9000: entrypoint còn chạy migrate + config:cache. Trong cửa sổ đó nginx TỰ SINH
# trang 502 — không có header CORS nào, vì Laravel (HandleCors) chưa hề chạy.
#
# FE gọi API KHÁC origin (dev: localhost:5173 → :8080, hoặc client như Mini App)
# bằng POST JSON nên trình duyệt gửi preflight OPTIONS trước. Preflight nhận 502
# thiếu CORS ⇒ trình duyệt chặn luôn, POST không bao giờ được gửi, axios chỉ thấy
# "Network Error" sau ~10 ms và màn đăng nhập hiện "Không kết nối được hệ thống.
# Kiểm tra kết nối mạng" dù mạng không lỗi gì. Nhật ký nginx 07/09–10/09/2026 có
# 6 lần `OPTIONS /api/v1/auth/login ... 502`, lần nào cũng trùng lúc backend đang
# khởi động ("backend could not be resolved" / "connect() failed (111)").
#
# Cách sửa: 502/503/504 do CHÍNH nginx sinh ra đi vào location riêng, trả JSON
# cùng dạng envelope lỗi của API, kèm CORS cho ĐÚNG các origin Laravel cho phép.
# Preflight lúc đó nhận 204 để request thật được gửi và nhận về 503 đọc được; FE
# nhờ vậy phân biệt "máy chủ đang khởi động lại" với "mất mạng" và tự chờ.
#
# KHÔNG bật fastcgi_intercept_errors: 5xx do chính PHP trả (health 503
# HEALTH_CHECK_DEGRADED, chế độ bảo trì) phải tới client nguyên vẹn.
#
# Giữ ĐỒNG BỘ khối này với docker/nginx/perf/default.conf.template —
# tests/Unit/DockerNginxBackendUnavailableTest.php khoá cả hai.
# ---------------------------------------------------------------------------

# Allow-list lấy từ CÙNG biến CORS_ALLOWED_ORIGINS mà config/cors.php đọc (compose
# truyền vào WMS_CORS_ALLOWED_ORIGINS), để hai tầng không thể lệch nhau. Chuỗi
# nguồn là "<origin>|<danh sách>,": regex bắt origin rồi dùng backreference \1 đòi
# nó trùng NGUYÊN MỘT phần tử của danh sách (không khớp tiền tố/hậu tố; chấp nhận
# khoảng trắng và "/" cuối như config/cors.php tự cắt). Origin lạ → chuỗi rỗng →
# nginx bỏ mọi header CORS bên dưới, đúng như Laravel từ chối.
map "$http_origin|${WMS_CORS_ALLOWED_ORIGINS}," $wms_gateway_cors_origin {
    default "";
    "~^([^|,\s]+)\|(?:[^|]*,)?\s*\1/?\s*," $http_origin;
}

map $wms_gateway_cors_origin $wms_gateway_cors_credentials {
    ""      "";
    default "true";
}

# config/cors.php mở mọi method/header (allowed_* = ['*']), nên preflight lặp lại
# đúng thứ trình duyệt hỏi — như fruitcake/php-cors làm khi có credentials.
map $wms_gateway_cors_origin $wms_gateway_cors_methods {
    ""      "";
    default $http_access_control_request_method;
}

map $wms_gateway_cors_origin $wms_gateway_cors_headers {
    ""      "";
    default $http_access_control_request_headers;
}

map $wms_gateway_cors_origin $wms_gateway_cors_expose {
    ""      "";
    default "Retry-After, X-Request-ID";
}

# Preflight trả 204 thì không mang Retry-After.
map $request_method $wms_gateway_retry_after {
    OPTIONS "";
    default "5";
}

server {
    listen 80;
    index index.php index.html;
    server_name localhost;
    root /var/www/html/public;
    # valid=5s là độ dài cửa sổ nginx còn dùng IP của container backend CŨ sau khi
    # nó bị tạo lại (hồ sơ perf đo: 10s → ~12 giây lỗi, 5s → ~6 giây).
    resolver 127.0.0.11 valid=5s ipv6=off;

    set $php_upstream backend:9000;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    keepalive_requests 1000;

    # Compress JSON/API responses and web assets before sending them to FE.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types
        application/json
        application/javascript
        application/xml
        image/svg+xml
        text/css
        text/plain;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass $php_upstream;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;

        # WWHN-SEC-03, phòng thủ nhiều lớp: không để phiên bản PHP lọt ra ngoài kể
        # cả khi image php-fpm cũ còn expose_php=On (production từng trả
        # `X-Powered-By: PHP/8.3.33`) hay request lỗi trước middleware
        # SecurityHeaders. Lớp PHP tương ứng: docker/php/security.ini.
        fastcgi_hide_header X-Powered-By;

        # Chuỗi forwarded gửi xuống PHP. $proxy_add_x_forwarded_for nối
        # $remote_addr vào cuối chuỗi client gửi lên, đúng thứ tự trái->phải mà
        # Symfony/Laravel duyệt ngược để loại các hop đã tin
        # (config/trustedproxy.php). IP giả do client tự đặt nằm bên trái một IP
        # không được tin nên bị bỏ qua.
        fastcgi_param HTTP_X_FORWARDED_FOR   $proxy_add_x_forwarded_for;
        fastcgi_param HTTP_X_FORWARDED_PROTO $wms_forwarded_proto;
        fastcgi_param HTTP_X_FORWARDED_HOST  $wms_forwarded_host;
        fastcgi_param HTTP_X_FORWARDED_PORT  $wms_forwarded_port;

        # Keep medium/large JSON responses in memory instead of spilling to a
        # temporary file before nginx forwards them to the browser.
        fastcgi_buffering on;
        fastcgi_buffer_size 32k;
        fastcgi_buffers 16 16k;
        fastcgi_busy_buffers_size 64k;

        # Backend đang khởi động lại phải lỗi NHANH: mặc định 60 s giữ request treo
        # tới một phút khi cache DNS còn trỏ IP container cũ (hồ sơ perf cũng 5 s).
        fastcgi_connect_timeout 5s;

        # Lỗi do CHÍNH nginx sinh ra → JSON + CORS (xem khối ở đầu file). 5xx do PHP
        # trả vẫn đi nguyên vẹn vì fastcgi_intercept_errors giữ mặc định (tắt).
        error_page 502 503 = @wms_backend_unavailable;
        error_page 504 = @wms_backend_timeout;
    }

    # 502/503 do nginx sinh ra: không phân giải / không kết nối được php-fpm — request
    # CHƯA tới ứng dụng, client gửi lại sau Retry-After là an toàn.
    location @wms_backend_unavailable {
        default_type "application/json; charset=utf-8";
        add_header Access-Control-Allow-Origin      $wms_gateway_cors_origin always;
        add_header Access-Control-Allow-Credentials $wms_gateway_cors_credentials always;
        add_header Access-Control-Allow-Methods     $wms_gateway_cors_methods always;
        add_header Access-Control-Allow-Headers     $wms_gateway_cors_headers always;
        add_header Access-Control-Expose-Headers    $wms_gateway_cors_expose always;
        add_header Vary Origin always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Request-ID $request_id always;
        add_header Retry-After $wms_gateway_retry_after always;

        if ($request_method = OPTIONS) {
            return 204;
        }

        return 503 '{"success":false,"message":"Hệ thống đang khởi động lại hoặc tạm gián đoạn. Vui lòng thử lại sau ít giây.","error_code":"BACKEND_UNAVAILABLE","errors":[],"error":{"code":"BACKEND_UNAVAILABLE","details":[]},"meta":{"request_id":"$request_id","timestamp":"$time_iso8601"}}';
    }

    # 504 do nginx sinh ra: php-fpm không trả lời kịp. Request có thể ĐÃ được xử lý nên
    # KHÔNG gửi Retry-After — client không được tự gửi lại.
    location @wms_backend_timeout {
        default_type "application/json; charset=utf-8";
        add_header Access-Control-Allow-Origin      $wms_gateway_cors_origin always;
        add_header Access-Control-Allow-Credentials $wms_gateway_cors_credentials always;
        add_header Access-Control-Allow-Methods     $wms_gateway_cors_methods always;
        add_header Access-Control-Allow-Headers     $wms_gateway_cors_headers always;
        add_header Access-Control-Expose-Headers    $wms_gateway_cors_expose always;
        add_header Vary Origin always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Request-ID $request_id always;

        if ($request_method = OPTIONS) {
            return 204;
        }

        return 504 '{"success":false,"message":"Máy chủ xử lý quá thời gian cho phép. Vui lòng thử lại sau; nếu vẫn lỗi, liên hệ quản trị viên.","error_code":"GATEWAY_TIMEOUT","errors":[],"error":{"code":"GATEWAY_TIMEOUT","details":[]},"meta":{"request_id":"$request_id","timestamp":"$time_iso8601"}}';
    }

    location ~ /\.ht {
        deny all;
    }
}
