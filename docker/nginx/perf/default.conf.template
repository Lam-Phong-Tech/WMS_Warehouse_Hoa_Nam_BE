# Server block của HỒ SƠ ĐO TẢI. Là bản sao của docker/nginx/default.conf.template
# (giữ NGUYÊN toàn bộ hợp đồng X-Forwarded-* của WWHN-295, không được đổi) cộng
# thêm phần điều chỉnh chịu tải. Không dùng cho stack dev.

map $http_x_forwarded_proto $wms_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

map $http_x_forwarded_host $wms_forwarded_host {
    default $http_x_forwarded_host;
    ""      $host;
}

map $http_x_forwarded_port $wms_forwarded_port {
    default $http_x_forwarded_port;
    ""      "${WMS_NGINX_EXTERNAL_PORT}";
}

# Resolver của Docker. `valid=5s` là ĐỘ DÀI CỬA SỔ 502 sau khi backend đổi IP:
# đo thật với valid=10s ra ~12 giây, với 5s còn ~6 giây. Chi phí là vài truy vấn
# DNS nội bộ mỗi giây — không đáng kể so với việc rút ngắn thời gian gián đoạn.
# PHẢI khai ở context `http` (file này được include vào
# trong `http {}`) thì khối `upstream` bên dưới mới dùng được — resolver đặt trong
# `server {}` chỉ áp cho proxy_pass biến, không áp cho upstream.
resolver 127.0.0.11 valid=5s ipv6=off;
resolver_timeout 5s;

# Upstream ĐỘNG có keepalive — bản sửa cho lỗi 502 sau khi recreate backend.
#
# LỖI CŨ: khối `upstream` tĩnh phân giải tên `backend` MỘT LẦN lúc nginx khởi
# động. Recreate riêng container backend là nó nhận IP mới, còn nginx vẫn giữ IP
# cũ và trả 502 cho tới khi có người nhớ ra phải restart nginx. Đó là một bước
# thủ công nằm giữa "deploy xong" và "hệ thống chạy" — kiểu bẫy chỉ phát tác lúc
# 2 giờ sáng.
#
# CÁCH SỬA: `zone` + tham số `resolve` trên `server`. nginx tự phân giải lại tên
# theo TTL của DNS và cập nhật danh sách peer trong bộ nhớ chia sẻ, KHÔNG cần
# reload. Tính năng này từng chỉ có ở NGINX Plus; đã kiểm chứng chạy được trên
# đúng ảnh `nginx:alpine` (nginx 1.31.3) mà stack này dùng, bằng `nginx -t`.
#
# `zone` cũng là điều kiện để trạng thái peer (max_fails/fail_timeout) dùng chung
# giữa các worker process thay vì mỗi worker đếm riêng.
#
# Mở rộng ngang NHIỀU MÁY: nối thêm `server host2:9000 resolve;` vào biến
# WMS_PHP_UPSTREAM_SERVERS (xem docker-compose.perf.yml) — nginx cân tải vòng
# tròn giữa chúng. Địa chỉ IP thuần cũng hợp lệ (có hoặc không có `resolve`).
upstream wms_php {
    zone wms_php 64k;

    ${WMS_PHP_UPSTREAM_SERVERS}

    # 128 → 8: xem ràng buộc worker_processes × keepalive ≤ tổng số child php-fpm
    # ở đầu nginx.conf. Giữ keepalive_requests/timeout cao để kết nối đã mở được
    # tái dùng lâu — cái cần chặn là SỐ LƯỢNG kết nối giữ, không phải tuổi thọ.
    keepalive 8;
    keepalive_requests 10000;
    keepalive_timeout 60s;
}

server {
    listen 80 backlog=8192;
    index index.php index.html;
    server_name localhost;
    root /var/www/html/public;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 75;
    keepalive_requests 10000;

    client_max_body_size ${WMS_NGINX_MAX_BODY};

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 4;
    gzip_types
        application/json
        application/javascript
        application/xml
        image/svg+xml
        text/css
        text/plain;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Trạng thái php-fpm — chỉ từ trong mạng docker / loopback (bằng chứng khi đo tải).
    location ~ ^/(fpm-status|fpm-ping)$ {
        allow 127.0.0.1;
        allow 172.16.0.0/12;
        allow 10.0.0.0/8;
        deny all;
        access_log off;
        fastcgi_pass wms_php;
        include fastcgi_params;
        fastcgi_param SCRIPT_NAME $uri;
        fastcgi_param SCRIPT_FILENAME $uri;
    }

    location ~ \.php$ {
        fastcgi_pass wms_php;
        fastcgi_index index.php;
        # Không dùng $document_root: php-fpm phục vụ bản chép mã trong container
        # (WMS_PHP_DOCROOT, xem docker-compose.perf.yml), còn root của nginx vẫn là
        # bind mount public/ để trả file tĩnh.
        fastcgi_param SCRIPT_FILENAME ${WMS_PHP_DOCROOT}$fastcgi_script_name;
        include fastcgi_params;

        # Bắt buộc để keepalive tới upstream có tác dụng.
        fastcgi_keep_conn on;

        fastcgi_param HTTP_X_FORWARDED_FOR   $proxy_add_x_forwarded_for;
        fastcgi_param HTTP_X_FORWARDED_PROTO $wms_forwarded_proto;
        fastcgi_param HTTP_X_FORWARDED_HOST  $wms_forwarded_host;
        fastcgi_param HTTP_X_FORWARDED_PORT  $wms_forwarded_port;

        fastcgi_buffering on;
        fastcgi_buffer_size 32k;
        fastcgi_buffers 32 16k;
        fastcgi_busy_buffers_size 64k;

        fastcgi_connect_timeout 5s;
        fastcgi_send_timeout ${WMS_NGINX_FASTCGI_TIMEOUT}s;
        fastcgi_read_timeout ${WMS_NGINX_FASTCGI_TIMEOUT}s;

        # PHÁT LẠI CÓ PHÂN LOẠI THEO PHƯƠNG THỨC — thay cho `off` trước đây.
        #
        # Lý do đổi: với nhiều backend, `off` nghĩa là một node chết làm hỏng cả
        # những request CHỈ ĐỌC, dù node còn lại đang rảnh và trả lời đúng được.
        # Đó là đánh mất phần lớn giá trị của việc chạy nhiều node.
        #
        # Vì sao an toàn: nginx MẶC ĐỊNH không bao giờ phát lại phương thức
        # không idempotent (POST, PATCH, LOCK) — chỉ phát lại khi có thêm cờ
        # `non_idempotent`, và cờ đó CỐ Ý KHÔNG được khai ở đây. Toàn bộ đường
        # ghi nguy hiểm của WMS (post-receipt, post-issue, reversal) là POST/PATCH:
        # 134 route POST + 31 route PATCH, không route nào được phát lại.
        #
        # Phần được phát lại là GET/HEAD (thuần đọc) và 2 route PUT + 8 route
        # DELETE. Đã rà từng cái: PUT là "gán RFID cho hiện vật" và "đồng bộ
        # permission của vai trò" — cả hai là gán-giá-trị, chạy hai lần cho cùng
        # kết quả; DELETE là xoá tài nguyên theo id, lần hai trả 404 chứ không
        # hỏng dữ liệu.
        #
        # `tries 2` + `timeout 10s`: chặn dây chuyền phát lại kéo dài khi nhiều
        # node cùng hỏng — thà trả lỗi sớm còn hơn giữ kết nối của người dùng.
        fastcgi_next_upstream error timeout;
        fastcgi_next_upstream_tries 2;
        fastcgi_next_upstream_timeout 10s;
    }

    location ~ /\.ht {
        deny all;
    }
}
