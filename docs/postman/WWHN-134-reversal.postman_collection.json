  "item": [
    {
      "name": "01 Create reversal - first write 201",
      "request": {
        "method": "POST",
        "description": "Contract case; not proof that the runtime is implemented.",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "X-Request-Id",
            "value": "{{$guid}}",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/reversals",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"original_document_type\": \"RECEIPT\",\n  \"original_document_id\": \"{{originalDocumentId}}\",\n  \"reason_code\": \"DATA_CORRECTION\",\n  \"reason\": \"Correct quantity posted by mistake\",\n  \"lines\": [\n    {\n      \"original_line_id\": \"{{originalLineId}}\",\n      \"quantity\": 1,\n      \"physical_return_status\": \"PENDING_RETURN\",\n      \"evidence_uri\": \"https://evidence.example.invalid/returns/RET-0001\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('standard success envelope', () => { pm.expect(json.success).to.eql(true); pm.expect(json).to.have.nested.property('meta.request_id'); });",
              "pm.test('no stack/internal path', () => { const raw = JSON.stringify(json).toLowerCase(); pm.expect(raw).not.to.include('stack trace'); pm.expect(raw).not.to.include('/var/www'); });"
            ]
          }
        }
      ]
    },
