              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('412', () => pm.response.to.have.status(412));",
                  "pm.test('error.code = STALE_VERSION', () => pm.expect(pm.response.json().error.code).to.eql('STALE_VERSION'));"
                ]
              }
            }
          ]
        },
        {
          "name": "A04 Refetch - 2 request loi KHONG doi version/status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/inbound-documents/{{inbound_id}}",
            "description": "Chung minh 428/412 la fail-closed: khong ghi du lieu, version giu nguyen."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('van DRAFT', () => pm.expect(d.status).to.eql('DRAFT'));",
                  "pm.test('version khong doi sau 428/412', () => pm.expect(String(d.version)).to.eql(pm.collectionVariables.get('inbound_version')));"
                ]
              }
            }
          ]
        }
      ]
    },
