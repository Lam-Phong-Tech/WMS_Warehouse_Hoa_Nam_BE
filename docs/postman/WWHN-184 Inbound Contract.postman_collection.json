        {
          "name": "S04 Resolve kho canonical KHO-TONG-HN",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/warehouses?per_page=100",
            "description": "EnsureCanonicalInboundWarehouse chi nhan dung warehouse code KHO-TONG-HN dang ACTIVE. Khong duoc lay data[0] tuy y."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('warehouse list 200', () => pm.response.to.have.status(200));",
                  "const w = pm.response.json().data.find(x => String(x.code).toUpperCase() === 'KHO-TONG-HN' && String(x.status).toUpperCase() === 'ACTIVE');",
                  "pm.test('ton tai kho canonical KHO-TONG-HN ACTIVE', () => pm.expect(w).to.not.be.undefined);",
                  "pm.collectionVariables.set('warehouse_id', w.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "S05 Resolve SKU COMPONENT khong serial-tracked, ACTIVE",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/skus?per_page=100",
            "description": "Chon tat dinh sku_type=COMPONENT + is_serial_tracked=false. Ly do: CurrentBaselineStockService bat buoc PRODUCT/serial-tracked phai scan tung item cu the (422 ITEM_REQUIRED, quantity=1), nen chi dong COMPONENT theo so luong moi kiem chung duoc bat bien version/full-post cua contract nay. Dong COMPONENT bat buoc gan BOX truoc khi scan (EnsureInboundComponentBox)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('sku list 200', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json().data.find(x => String(x.sku_type).toUpperCase() === 'COMPONENT' && String(x.status).toUpperCase() === 'ACTIVE' && !x.is_serial_tracked);",
                  "pm.test('ton tai SKU COMPONENT ACTIVE khong serial-tracked', () => pm.expect(s).to.not.be.undefined);",
                  "pm.collectionVariables.set('product_id', s.sku_id || s.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Create DRAFT & optimistic lock",
      "item": [
        {
          "name": "A01 Create inbound DRAFT -> 201 DRAFT version=1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/inbound-documents",
            "description": "REQ-SRS-006: tao inbound DRAFT, chua tang ton.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doc_no\": \"PN-WWHN184-A-{{run_id}}\",\n  \"dst_warehouse_id\": \"{{warehouse_id}}\",\n  \"source_reference\": \"WWHN-184 contract run {{run_id}}\",\n  \"lines\": [\n    {\n      \"product_id\": \"{{product_id}}\",\n      \"qty_planned\": 5\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create 201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.test('status DRAFT', () => pm.expect(d.status).to.eql('DRAFT'));",
                  "pm.test('version khoi tao = 1', () => pm.expect(d.version).to.eql(1));",
                  "pm.test('ETag khop data.version', () => pm.expect(pm.response.headers.get('ETag')).to.eql('\"' + d.version + '\"'));",
                  "pm.collectionVariables.set('inbound_id', d.id);",
                  "pm.collectionVariables.set('inbound_line_id', d.lines[0].id);",
                  "pm.collectionVariables.set('inbound_version', String(d.version));"
                ]
              }
            }
          ]
        },
        {
          "name": "A01b Dang ky BOX cho dong COMPONENT (stock-neutral, khong doi version)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/boxes",
            "description": "EnsureInboundComponentBox: dong nhap COMPONENT bat buoc container_id tro toi BOX EMPTY dung SKU. Dang ky BOX chi ghi bang containers nen KHONG bump version cua stock_documents.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"line_id\": \"{{inbound_line_id}}\",\n  \"box_code\": \"BOX-WWHN184-A-{{run_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('box 201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('box_id_a', d.container_id);",
                  "pm.test('BOX EMPTY va dung SKU cua line', () => { pm.expect(String(d.status).toUpperCase()).to.eql('EMPTY'); pm.expect(d.primary_sku_id).to.eql(pm.collectionVariables.get('product_id')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "A01c Refetch - dang ky BOX khong lam doi version phieu",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/inbound-documents/{{inbound_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
