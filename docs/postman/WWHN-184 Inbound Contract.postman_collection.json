            "description": "AuthDatabaseSeeder: manager01@gmail.com = WAREHOUSE_MANAGER, co du inbound.view/create/scan/post/cancel.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{managerEmail}}\",\n  \"password\": \"{{managerPassword}}\"\n}",
              "options": {
