{"info":{"name":"WWHN-184 Inbound Contract","description":"Executable contract cho Inbound Document API (WWHN-184/WWHN-41, BE1): create/update/scan/unscan/cancel/post-receipt/reverse. Baseline hiện hành KHÔNG có submit/approve — state machine chỉ DRAFT -> SCANNING -> POSTED/CANCELLED, Full Post duy nhất. Cover cả trường hợp WAREHOUSE_STAFF (chỉ có inbound.create) vẫn cancel được vì route nhận inbound.cancel|inbound.create (DEV184-P1-01R). Credentials chỉ inject lúc chạy.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json","version":{"major":1,"minor":0,"patch":0}},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{access_token}}","type":"string"}]},"variable":[{"key":"base_url","value":"http://127.0.0.1:8000"},{"key":"access_token","value":""},{"key":"staff_only_create_token","value":""},{"key":"warehouse_id","value":""},{"key":"product_id","value":""},{"key":"inbound_id","value":""},{"key":"inbound_line_id","value":""},{"key":"inbound_version","value":""},{"key":"scan_entry_id","value":""},{"key":"run_id","value":""}],"event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.collectionVariables.get('run_id')) pm.collectionVariables.set('run_id', Date.now().toString());"]}}],"item":[{"name":"01 Login manager (inbound.create + inbound.cancel + inbound.scan + inbound.post)","request":{"method":"POST","url":"{{base_url}}/api/v1/auth/login","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}"}},"auth":{"type":"noauth"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('manager login 200', () => pm.response.to.have.status(200));","pm.collectionVariables.set('access_token', pm.response.json().data.access_token);"]}}]},{"name":"02 Login WAREHOUSE_STAFF (chỉ inbound.create, không có inbound.cancel)","request":{"method":"POST","url":"{{base_url}}/api/v1/auth/login","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{staffEmail}}\",\"password\":\"{{staffPassword}}\"}"}},"auth":{"type":"noauth"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('staff login 200', () => pm.response.to.have.status(200));","pm.collectionVariables.set('staff_only_create_token', pm.response.json().data.access_token);"]}}]},{"name":"03 Resolve warehouse","request":{"method":"GET","url":"{{base_url}}/api/v1/warehouses"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('warehouse list 200', () => pm.response.to.have.status(200));","pm.collectionVariables.set('warehouse_id', pm.response.json().data[0].id);"]}}]},{"name":"04 Resolve product","request":{"method":"GET","url":"{{base_url}}/api/v1/skus?per_page=1"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('sku list 200', () => pm.response.to.have.status(200));","pm.collectionVariables.set('product_id', pm.response.json().data[0].sku_id ?? pm.response.json().data[0].id);"]}}]},{"name":"05 Create inbound DRAFT (Idempotency-Key optional)","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"doc_no\":\"PN-WWHN184-{{run_id}}\",\"dst_warehouse_id\":\"{{warehouse_id}}\",\"lines\":[{\"product_id\":\"{{product_id}}\",\"qty_planned\":5}]}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('create inbound 201', () => pm.response.to.have.status(201));","pm.test('status DRAFT', () => pm.expect(pm.response.json().data.status).to.eql('DRAFT'));","pm.collectionVariables.set('inbound_id', pm.response.json().data.id);","pm.collectionVariables.set('inbound_line_id', pm.response.json().data.lines[0].id);","pm.collectionVariables.set('inbound_version', pm.response.json().data.version);"]}}]},{"name":"06 Update without If-Match -> 428","request":{"method":"PATCH","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"note\":\"missing if-match\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('missing If-Match 428', () => pm.response.to.have.status(428));"]}}]},{"name":"07 Update with stale If-Match -> 412 STALE_VERSION","request":{"method":"PATCH","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}","header":[{"key":"Content-Type","value":"application/json"},{"key":"If-Match","value":"9999"}],"body":{"mode":"raw","raw":"{\"note\":\"stale version\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('stale version 412', () => pm.response.to.have.status(412));","pm.test('error code STALE_VERSION', () => pm.expect(pm.response.json().error.code).to.eql('STALE_VERSION'));"]}}]},{"name":"08 Scan full expected qty","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/scan","header":[{"key":"Content-Type","value":"application/json"},{"key":"If-Match","value":"{{inbound_version}}"}],"body":{"mode":"raw","raw":"{\"line_id\":\"{{inbound_line_id}}\",\"qty\":5}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('scan 200', () => pm.response.to.have.status(200));","pm.test('stock_effect NONE (stock-neutral)', () => pm.expect(pm.response.json().data.stock_effect).to.eql('NONE'));","pm.collectionVariables.set('inbound_version', pm.response.json().data.version);"]}}]},{"name":"09 List scan entries (audit trail)","request":{"method":"GET","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/scan-entries?status=ACTIVE"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('scan entries 200', () => pm.response.to.have.status(200));","pm.test('at least one ACTIVE entry', () => pm.expect(pm.response.json().data.length).to.be.above(0));","pm.collectionVariables.set('scan_entry_id', pm.response.json().data[0].id);"]}}]},{"name":"10 Post receipt without full scan (already full here, negative-case template)","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/post-receipt","header":[{"key":"If-Match","value":"{{inbound_version}}"}]},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('missing Idempotency-Key 428', () => pm.response.to.have.status(428));"]}}]},{"name":"11 Cancel with WAREHOUSE_STAFF token (inbound.create only) -> phải 200, KHÔNG 403","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/cancel","header":[{"key":"Content-Type","value":"application/json"},{"key":"If-Match","value":"{{inbound_version}}"}],"body":{"mode":"raw","raw":"{\"reason\":\"DEV184-P1-01R regression: inbound.create phải đủ để cancel, khớp route inbound.cancel|inbound.create\"}"}},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{staff_only_create_token}}","type":"string"}]},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('staff (inbound.create only) can cancel: 200', () => pm.response.to.have.status(200));","pm.test('status CANCELLED', () => pm.expect(pm.response.json().data.status).to.eql('CANCELLED'));"]}}]},{"name":"12 Cancel lần 2 (đã CANCELLED) -> 409 STATE_CONFLICT","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/cancel","header":[{"key":"Content-Type","value":"application/json"},{"key":"If-Match","value":"{{inbound_version}}"}],"body":{"mode":"raw","raw":"{\"reason\":\"double cancel probe\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('double cancel 409', () => pm.response.to.have.status(409));","pm.test('error code STATE_CONFLICT', () => pm.expect(pm.response.json().error.code).to.eql('STATE_CONFLICT'));"]}}]},{"name":"13 Create second inbound for full Post Receipt path","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"doc_no\":\"PN-WWHN184-POST-{{run_id}}\",\"dst_warehouse_id\":\"{{warehouse_id}}\",\"lines\":[{\"product_id\":\"{{product_id}}\",\"qty_planned\":3}]}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('create inbound 201', () => pm.response.to.have.status(201));","pm.collectionVariables.set('inbound_id', pm.response.json().data.id);","pm.collectionVariables.set('inbound_line_id', pm.response.json().data.lines[0].id);","pm.collectionVariables.set('inbound_version', pm.response.json().data.version);"]}}]},{"name":"14 Scan full qty for second inbound","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/scan","header":[{"key":"Content-Type","value":"application/json"},{"key":"If-Match","value":"{{inbound_version}}"}],"body":{"mode":"raw","raw":"{\"line_id\":\"{{inbound_line_id}}\",\"qty\":3}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('scan 200', () => pm.response.to.have.status(200));","pm.collectionVariables.set('inbound_version', pm.response.json().data.version);"]}}]},{"name":"15 Post receipt (Idempotency-Key + If-Match, tăng tồn đúng 1 lần)","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/post-receipt","header":[{"key":"If-Match","value":"{{inbound_version}}"},{"key":"Idempotency-Key","value":"wwhn184-post-{{run_id}}"}]},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('post receipt 200', () => pm.response.to.have.status(200));","pm.test('status POSTED', () => pm.expect(pm.response.json().data.status).to.eql('POSTED'));"]}}]},{"name":"16 Replay cùng Idempotency-Key -> trả lại đúng response cũ, KHÔNG tăng tồn lần 2","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/post-receipt","header":[{"key":"If-Match","value":"{{inbound_version}}"},{"key":"Idempotency-Key","value":"wwhn184-post-{{run_id}}"}]},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('replay 200', () => pm.response.to.have.status(200));","pm.test('replayed=true', () => pm.expect(pm.response.json().data.replayed).to.eql(true));"]}}]},{"name":"17 Cùng key, payload khác -> 409 IDEMPOTENCY_ERROR","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/post-receipt","header":[{"key":"Content-Type","value":"application/json"},{"key":"If-Match","value":"{{inbound_version}}"},{"key":"Idempotency-Key","value":"wwhn184-post-{{run_id}}"}],"body":{"mode":"raw","raw":"{\"probe\":\"different-payload\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('payload conflict 409', () => pm.response.to.have.status(409));","pm.test('error code IDEMPOTENCY_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('IDEMPOTENCY_ERROR'));"]}}]},{"name":"18 Post lại với key khác trên chứng từ đã POSTED -> 409 STATE_CONFLICT","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/post-receipt","header":[{"key":"If-Match","value":"{{inbound_version}}"},{"key":"Idempotency-Key","value":"wwhn184-post-second-{{run_id}}"}]},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('double post different key 409', () => pm.response.to.have.status(409));","pm.test('error code STATE_CONFLICT', () => pm.expect(pm.response.json().error.code).to.eql('STATE_CONFLICT'));"]}}]},{"name":"19 Cancel chứng từ đã POSTED -> 409 (Cancel chỉ áp dụng DRAFT/SCANNING)","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/cancel","header":[{"key":"Content-Type","value":"application/json"},{"key":"If-Match","value":"{{inbound_version}}"}],"body":{"mode":"raw","raw":"{\"reason\":\"cancel posted probe\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('cancel after POSTED 409', () => pm.response.to.have.status(409));","pm.test('error code STATE_CONFLICT', () => pm.expect(pm.response.json().error.code).to.eql('STATE_CONFLICT'));"]}}]}]}
