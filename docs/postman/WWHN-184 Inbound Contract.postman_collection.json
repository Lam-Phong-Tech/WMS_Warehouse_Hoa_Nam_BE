{
  "info": {
    "_postman_id": "wwhn-184-inbound-contract",
    "name": "WWHN-184 Inbound Contract",
    "description": "Contract chay duoc cho toan bo Inbound Document API (WWHN-184 / task cha WWHN-41).\n\nBAT BIEN BAT BUOC (DEV184-P1-01R): moi request doi trang thai phai bat lai version tu data.version va doi chieu ETag; moi state probe sau mutation phai dung sau mot refetch GET.\nLy do: cancelDocument()/postDocument() goi assertVersion() TRUOC khi kiem tra status. Neu probe gui version cu, no bi chan o 412 STALE_VERSION va khong bao gio cham state guard, nen assertion 409 se fail.\n\nVerifier tinh: scripts/verify-wwhn184-postman-contract.mjs (chay trong CI, chan regression bat bien nay).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run_id')) {",
          "  pm.collectionVariables.set('run_id', String(Date.now()) + '-' + Math.floor(Math.random() * 100000));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "staff_only_create_token",
      "value": ""
    },
    {
      "key": "viewer_token",
      "value": ""
    },
    {
      "key": "warehouse_id",
      "value": ""
    },
    {
      "key": "product_id",
      "value": ""
    },
    {
      "key": "inbound_id",
      "value": ""
    },
    {
      "key": "inbound_line_id",
      "value": ""
    },
    {
      "key": "box_id_a",
      "value": ""
    },
    {
      "key": "box_id_b",
      "value": ""
    },
    {
      "key": "inbound_version",
      "value": ""
