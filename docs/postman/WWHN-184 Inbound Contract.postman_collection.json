    {
      "name": "04 Cancel - RBAC OR-permission & state",
      "item": [
        {
          "name": "D01 Cancel bang token WAREHOUSE_STAFF (chi inbound.create) -> 200, KHONG 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "If-Match",
                "value": "{{inbound_version}}",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/cancel",
            "description": "Annex C dong 1443 cancelInboundDocument = inbound.cancel|inbound.create.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"DEV184-P1-01R regression: route khai inbound.cancel|inbound.create nen inbound.create phai du de Cancel\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staff_only_create_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('staff (chi inbound.create) cancel duoc: 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('status CANCELLED', () => pm.expect(d.status).to.eql('CANCELLED'));",
                  "pm.test('ETag khop data.version', () => pm.expect(pm.response.headers.get('ETag')).to.eql('\"' + d.version + '\"'));",
                  "pm.collectionVariables.set('inbound_stale_version', String(d.version - 1));",
                  "pm.collectionVariables.set('inbound_version', String(d.version));"
                ]
              }
            }
          ]
        },
        {
          "name": "D02 Refetch sau Cancel -> CANCELLED + version khop",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/inbound-documents/{{inbound_id}}",
            "description": "DEV184-P1-01R: state probe chi hop le khi da refresh version sau mutation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "pm.test('status CANCELLED', () => pm.expect(d.status).to.eql('CANCELLED'));",
                  "pm.test('version refetch khop version da bat sau Cancel', () => pm.expect(String(d.version)).to.eql(pm.collectionVariables.get('inbound_version')));"
                ]
              }
            }
          ]
        },
        {
          "name": "D03 Cancel lan 2 voi version MOI -> 409 STATE_CONFLICT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "If-Match",
                "value": "{{inbound_version}}",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/cancel",
            "description": "Chi khi If-Match la version hien hanh thi request moi di qua assertVersion va cham duoc state guard (CANCELLED la terminal).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"double cancel probe - version da refresh nen phai cham state guard\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
