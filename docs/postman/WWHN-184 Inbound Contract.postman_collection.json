                  "pm.test('version khong doi sau khi dang ky BOX', () => pm.expect(String(d.version)).to.eql(pm.collectionVariables.get('inbound_version')));"
                ]
              }
            }
          ]
        },
        {
          "name": "A02 PATCH thieu If-Match -> 428 PRECONDITION_REQUIRED",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/inbound-documents/{{inbound_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"missing if-match\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
