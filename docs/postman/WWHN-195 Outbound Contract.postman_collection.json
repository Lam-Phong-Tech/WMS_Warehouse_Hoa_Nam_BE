              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('mode doi duoc trong cung phieu', () => pm.expect(json.data.scan_source).to.eql('CAMERA'));",
              "pm.test('alias /scans cung handler voi /scan', () => pm.expect(json.data.stock_effect).to.eql('NONE'));",
              "pm.test('full match -> 01 Packing Label DRAFT', () => {",
              "  pm.expect(json.data.packing_label_ready).to.eql(true);",
              "  pm.expect(json.data.label_status).to.eql('DRAFT');",
              "});",
              "pm.environment.set('documentVersion', String(json.data.version));",
              "pm.environment.set('labelId', json.data.label_snapshot_id);",
              "pm.environment.set('labelVersion', '1');"
            ]
