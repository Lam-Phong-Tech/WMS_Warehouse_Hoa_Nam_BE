{
  "info": {
    "_postman_id": "a8f4e690-7f50-4e6d-9150-wwhn1500001",
    "name": "WWHN-150 Scan ReadOnly Contract",
    "description": "Executable contract for scan/classify read-only invariants. Database before/after proof is produced by CI fingerprint comparison.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": {
      "major": 1,
      "minor": 1,
      "patch": 0
    }
  },
  "item": [
    {
      "name": "01 Login manager",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json", "type": "text"}],
        "url": {"raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"]},
        "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}", "options": {"raw": {"language": "json"}}}
      },
      "response": [],
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('login 200', () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.environment.set('accessToken', json.data.access_token);"]}}]
    },
    {
      "name": "02 Resolve warehouse",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text"}],
        "url": {"raw": "{{baseUrl}}/api/v1/warehouses", "host": ["{{baseUrl}}"], "path": ["api", "v1", "warehouses"]}
      },
      "response": [],
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('warehouse list 200', () => pm.response.to.have.status(200));", "const json = pm.response.json();", "const warehouse = json.data.find((row) => row.code === 'KHO-TONG-HN');", "const mismatchWarehouse = json.data.find((row) => row.id !== warehouse?.id);", "pm.test('seed warehouse exists', () => pm.expect(warehouse).to.be.an('object'));", "pm.test('mismatch warehouse exists', () => pm.expect(mismatchWarehouse).to.be.an('object'));", "pm.environment.set('warehouseId', warehouse.id);", "pm.environment.set('mismatchWarehouseId', mismatchWarehouse.id);"]}}]
    },
    {
      "name": "03 Scan success read-only",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text"},
          {"key": "Idempotency-Key", "value": "WWHN-150-SCAN-READONLY-001", "type": "text"},
          {"key": "Content-Type", "value": "application/json", "type": "text"}
        ],
        "url": {"raw": "{{baseUrl}}/api/v1/scan/classify", "host": ["{{baseUrl}}"], "path": ["api", "v1", "scan", "classify"]},
        "body": {"mode": "raw", "raw": "{\n  \"raw_code\": \"HN-PV-2026-00001\",\n  \"context\": \"STOCKTAKE\",\n  \"warehouse_id\": \"{{warehouseId}}\"\n}", "options": {"raw": {"language": "json"}}}
      },
      "response": [],
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "const json = pm.response.json();",
        "pm.test('success envelope', () => pm.expect(json.success).to.eql(true));",
        "pm.test('classification ITEM', () => pm.expect(json.data.classification).to.eql('ITEM'));",
        "pm.test('contract version locked', () => pm.expect(json.data.contract_version).to.eql('WWHN-150.1.1.0'));",
        "pm.test('resolved source present', () => pm.expect(json.data.resolved_source).to.be.a('string').and.not.empty);",
        "pm.test('stock_effect NONE', () => pm.expect(json.data.stock_effect).to.eql('NONE'));",
        "pm.test('movement_created false', () => pm.expect(json.data.movement_created).to.eql(false));",
        "pm.test('posting_event_created false', () => pm.expect(json.data.posting_event_created).to.eql(false));",
        "pm.test('idempotency_cache_written false', () => pm.expect(json.data.idempotency_cache_written).to.eql(false));",
        "pm.test('warehouse matches', () => pm.expect(json.data.current_location.warehouse_id).to.eql(pm.environment.get('warehouseId')));"
      ]}}]
    },
    {
      "name": "04 Scan same key replay remains read-only",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text"},
          {"key": "Idempotency-Key", "value": "WWHN-150-SCAN-READONLY-001", "type": "text"},
          {"key": "Content-Type", "value": "application/json", "type": "text"}
        ],
        "url": {"raw": "{{baseUrl}}/api/v1/scan/classify", "host": ["{{baseUrl}}"], "path": ["api", "v1", "scan", "classify"]},
        "body": {"mode": "raw", "raw": "{\n  \"raw_code\": \"HN-PV-2026-00001\",\n  \"context\": \"STOCKTAKE\",\n  \"warehouse_id\": \"{{warehouseId}}\"\n}", "options": {"raw": {"language": "json"}}}
      },
      "response": [],
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "const json = pm.response.json();",
        "pm.test('success envelope', () => pm.expect(json.success).to.eql(true));",
        "pm.test('classification ITEM', () => pm.expect(json.data.classification).to.eql('ITEM'));",
        "pm.test('contract version locked', () => pm.expect(json.data.contract_version).to.eql('WWHN-150.1.1.0'));",
        "pm.test('resolved source present', () => pm.expect(json.data.resolved_source).to.be.a('string').and.not.empty);",
        "pm.test('stock_effect NONE', () => pm.expect(json.data.stock_effect).to.eql('NONE'));",
        "pm.test('movement_created false', () => pm.expect(json.data.movement_created).to.eql(false));",
        "pm.test('posting_event_created false', () => pm.expect(json.data.posting_event_created).to.eql(false));",
        "pm.test('idempotency_cache_written false', () => pm.expect(json.data.idempotency_cache_written).to.eql(false));",
        "pm.test('warehouse matches', () => pm.expect(json.data.current_location.warehouse_id).to.eql(pm.environment.get('warehouseId')));",
        "pm.test('not an idempotency replay cache', () => pm.expect(pm.response.headers.has('Idempotency-Replayed')).to.eql(false));"
      ]}}]
    },
    {
      "name": "05 Scan warehouse mismatch 409",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text"},
          {"key": "Content-Type", "value": "application/json", "type": "text"}
        ],
        "url": {"raw": "{{baseUrl}}/api/v1/scan/classify", "host": ["{{baseUrl}}"], "path": ["api", "v1", "scan", "classify"]},
        "body": {"mode": "raw", "raw": "{\n  \"raw_code\": \"HN-PV-2026-00001\",\n  \"context\": \"STOCKTAKE\",\n  \"warehouse_id\": \"{{mismatchWarehouseId}}\"\n}", "options": {"raw": {"language": "json"}}}
      },
      "response": [],
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('status 409', () => pm.response.to.have.status(409));", "pm.test('explicit code', () => pm.expect(pm.response.json().error_code).to.eql('SCAN_WAREHOUSE_MISMATCH'));", "pm.test('no stock effect payload', () => pm.expect(pm.response.json().data).to.eql(undefined));"]}}]
    },
    {
      "name": "06 Scan unknown code 404",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text"},
          {"key": "Content-Type", "value": "application/json", "type": "text"}
        ],
        "url": {"raw": "{{baseUrl}}/api/v1/scan/classify", "host": ["{{baseUrl}}"], "path": ["api", "v1", "scan", "classify"]},
        "body": {"mode": "raw", "raw": "{\n  \"raw_code\": \"UNKNOWN-WWHN-150-CI\",\n  \"context\": \"STOCKTAKE\",\n  \"warehouse_id\": \"{{warehouseId}}\"\n}", "options": {"raw": {"language": "json"}}}
      },
      "response": [],
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('status 404', () => pm.response.to.have.status(404));", "pm.test('explicit code', () => pm.expect(pm.response.json().error_code).to.eql('SCAN_CODE_NOT_FOUND'));"]}}]
    },
    {
      "name": "07 Scan validation 422",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text"},
          {"key": "Content-Type", "value": "application/json", "type": "text"}
        ],
        "url": {"raw": "{{baseUrl}}/api/v1/scan/classify", "host": ["{{baseUrl}}"], "path": ["api", "v1", "scan", "classify"]},
        "body": {"mode": "raw", "raw": "{\n  \"context\": \"STOCKTAKE\",\n  \"warehouse_id\": \"{{warehouseId}}\"\n}", "options": {"raw": {"language": "json"}}}
      },
      "response": [],
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('status 422', () => pm.response.to.have.status(422));"]}}]
    },
    {
      "name": "08 Login no permission",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json", "type": "text"}],
        "url": {"raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"]},
        "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{noPermissionEmail}}\",\n  \"password\": \"{{noPermissionPassword}}\"\n}", "options": {"raw": {"language": "json"}}}
      },
      "response": [],
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('login no-permission user 200', () => pm.response.to.have.status(200));", "pm.environment.set('noPermissionToken', pm.response.json().data.access_token);"]}}]
    },
    {
      "name": "09 Scan permission denied",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{noPermissionToken}}", "type": "text"},
          {"key": "Content-Type", "value": "application/json", "type": "text"}
        ],
        "url": {"raw": "{{baseUrl}}/api/v1/scan/classify", "host": ["{{baseUrl}}"], "path": ["api", "v1", "scan", "classify"]},
        "body": {"mode": "raw", "raw": "{\n  \"raw_code\": \"HN-PV-2026-00001\",\n  \"context\": \"STOCKTAKE\",\n  \"warehouse_id\": \"{{warehouseId}}\"\n}", "options": {"raw": {"language": "json"}}}
      },
      "response": [],
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('status 403', () => pm.response.to.have.status(403));"]}}]
    }
  ],
  "variable": []
}
