{"info":{"name":"WWHN-180 Posting Contract","description":"Executable G1 contract for scan/post-receipt/post-issue: happy path, missing key, replay, payload conflict, different-key double post, RBAC and reconciliation. Version 1.1.0 PROPOSED; credentials are injected only at runtime.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json","version":{"major":1,"minor":1,"patch":0}},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{access_token}}","type":"string"}]},"variable":[{"key":"base_url","value":"http://127.0.0.1:8000"},{"key":"access_token","value":""},{"key":"no_permission_token","value":""},{"key":"warehouse_id","value":""},{"key":"product_id","value":""},{"key":"inbound_id","value":""},{"key":"inbound_line_id","value":""},{"key":"outbound_id","value":""},{"key":"receipt_movement_id","value":""},{"key":"issue_movement_id","value":""},{"key":"run_id","value":""}],"event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.collectionVariables.get('run_id')) pm.collectionVariables.set('run_id', Date.now().toString());"]}}],"item":[{"name":"01 Login manager","request":{"method":"POST","url":"{{base_url}}/api/v1/auth/login","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}"}},"auth":{"type":"noauth"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('manager login 200', () => pm.response.to.have.status(200));","pm.collectionVariables.set('access_token', pm.response.json().data.access_token);"]}}]},{"name":"02 Login no-permission user","request":{"method":"POST","url":"{{base_url}}/api/v1/auth/login","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{noPermissionEmail}}\",\"password\":\"{{noPermissionPassword}}\"}"}},"auth":{"type":"noauth"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('no-permission login 200', () => pm.response.to.have.status(200));","pm.collectionVariables.set('no_permission_token', pm.response.json().data.access_token);"]}}]},{"name":"03 Resolve warehouse","request":{"method":"GET","url":"{{base_url}}/api/v1/warehouses"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('warehouse list 200', () => pm.response.to.have.status(200));","pm.test('warehouse exists', () => pm.expect(pm.response.json().data.length).to.be.above(0));","pm.collectionVariables.set('warehouse_id', pm.response.json().data[0].id);"]}}]},{"name":"04 Resolve product","request":{"method":"GET","url":"{{base_url}}/api/v1/products?per_page=1"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('product list 200', () => pm.response.to.have.status(200));","pm.test('product exists', () => pm.expect(pm.response.json().data.length).to.be.above(0));","pm.collectionVariables.set('product_id', pm.response.json().data[0].id);"]}}]},{"name":"05 Create inbound","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"wwhn180-create-in-{{run_id}}"}],"body":{"mode":"raw","raw":"{\"doc_no\":\"PN-WWHN180-{{run_id}}\",\"dst_warehouse_id\":\"{{warehouse_id}}\",\"lines\":[{\"product_id\":\"{{product_id}}\",\"qty_planned\":10}]}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('create inbound 201', () => pm.response.to.have.status(201));","pm.collectionVariables.set('inbound_id', pm.response.json().data.id);","pm.collectionVariables.set('inbound_line_id', pm.response.json().data.lines[0].id);"]}}]},{"name":"06 Submit inbound","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/submit"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('submit inbound 200', () => pm.response.to.have.status(200));","pm.test('pending', () => pm.expect(pm.response.json().data.status).to.eql('pending'));"]}}]},{"name":"07 Approve inbound","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/approve"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('approve inbound 200', () => pm.response.to.have.status(200));","pm.test('approved', () => pm.expect(pm.response.json().data.status).to.eql('approved'));"]}}]},{"name":"08 Scan inbound has no stock effect","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/scan","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"line_id\":\"{{inbound_line_id}}\",\"qty\":4}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('scan 200', () => pm.response.to.have.status(200));","pm.test('stock_effect NONE', () => pm.expect(pm.response.json().data.stock_effect).to.eql('NONE'));","pm.test('movement not created', () => pm.expect(pm.response.json().data.movement_created).to.eql(false));","pm.test('document remains approved', () => pm.expect(pm.response.json().data.status).to.eql('approved'));"]}}]},{"name":"09 Post receipt missing key","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/post-receipt"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('missing receipt key 428', () => pm.response.to.have.status(428));","pm.test('precondition code', () => pm.expect(pm.response.json().error.code).to.eql('PRECONDITION_REQUIRED'));"]}}]},{"name":"10 Post receipt","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/post-receipt","header":[{"key":"Idempotency-Key","value":"wwhn180-post-in-{{run_id}}"}]},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('post receipt 200', () => pm.response.to.have.status(200));","pm.test('received', () => pm.expect(pm.response.json().data.status).to.eql('received'));","pm.test('one movement returned', () => pm.expect(pm.response.json().data.movements.length).to.eql(1));","pm.collectionVariables.set('receipt_movement_id', pm.response.json().data.movements[0].id);"]}}]},{"name":"11 Replay receipt exact snapshot","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/post-receipt","header":[{"key":"Idempotency-Key","value":"wwhn180-post-in-{{run_id}}"}]},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('receipt replay 200', () => pm.response.to.have.status(200));","pm.test('same receipt movement', () => pm.expect(pm.response.json().data.movements[0].id).to.eql(pm.collectionVariables.get('receipt_movement_id')));"]}}]},{"name":"12 Same receipt key different payload","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/post-receipt","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"wwhn180-post-in-{{run_id}}"}],"body":{"mode":"raw","raw":"{\"probe\":\"different-payload\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('receipt payload conflict 409', () => pm.response.to.have.status(409));","pm.test('idempotency code', () => pm.expect(pm.response.json().error.code).to.eql('IDEMPOTENCY_ERROR'));"]}}]},{"name":"13 Different receipt key double-post","request":{"method":"POST","url":"{{base_url}}/api/v1/inbound-documents/{{inbound_id}}/post-receipt","header":[{"key":"Idempotency-Key","value":"wwhn180-post-in-second-{{run_id}}"}]},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('receipt double-post 409', () => pm.response.to.have.status(409));","pm.test('state conflict', () => pm.expect(pm.response.json().error.code).to.eql('STATE_CONFLICT'));"]}}]},{"name":"14 Create outbound","request":{"method":"POST","url":"{{base_url}}/api/v1/outbound-documents","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"wwhn180-create-out-{{run_id}}"}],"body":{"mode":"raw","raw":"{\"doc_no\":\"PX-WWHN180-{{run_id}}\",\"src_warehouse_id\":\"{{warehouse_id}}\",\"lines\":[{\"product_id\":\"{{product_id}}\",\"qty_planned\":3}]}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('create outbound 201', () => pm.response.to.have.status(201));","pm.collectionVariables.set('outbound_id', pm.response.json().data.id);"]}}]},{"name":"15 Submit outbound","request":{"method":"POST","url":"{{base_url}}/api/v1/outbound-documents/{{outbound_id}}/submit"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('submit outbound 200', () => pm.response.to.have.status(200));"]}}]},{"name":"16 Approve outbound","request":{"method":"POST","url":"{{base_url}}/api/v1/outbound-documents/{{outbound_id}}/approve"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('approve outbound 200', () => pm.response.to.have.status(200));"]}}]},{"name":"17 Post issue missing key","request":{"method":"POST","url":"{{base_url}}/api/v1/outbound-documents/{{outbound_id}}/post-issue"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('missing issue key 428', () => pm.response.to.have.status(428));","pm.test('precondition code', () => pm.expect(pm.response.json().error.code).to.eql('PRECONDITION_REQUIRED'));"]}}]},{"name":"18 Post issue","request":{"method":"POST","url":"{{base_url}}/api/v1/outbound-documents/{{outbound_id}}/post-issue","header":[{"key":"Idempotency-Key","value":"wwhn180-post-out-{{run_id}}"}]},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('post issue 200', () => pm.response.to.have.status(200));","pm.test('issued', () => pm.expect(pm.response.json().data.status).to.eql('issued'));","pm.test('one movement returned', () => pm.expect(pm.response.json().data.movements.length).to.eql(1));","pm.collectionVariables.set('issue_movement_id', pm.response.json().data.movements[0].id);"]}}]},{"name":"19 Replay issue exact snapshot","request":{"method":"POST","url":"{{base_url}}/api/v1/outbound-documents/{{outbound_id}}/post-issue","header":[{"key":"Idempotency-Key","value":"wwhn180-post-out-{{run_id}}"}]},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('issue replay 200', () => pm.response.to.have.status(200));","pm.test('same issue movement', () => pm.expect(pm.response.json().data.movements[0].id).to.eql(pm.collectionVariables.get('issue_movement_id')));"]}}]},{"name":"20 Same issue key different payload","request":{"method":"POST","url":"{{base_url}}/api/v1/outbound-documents/{{outbound_id}}/post-issue","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"wwhn180-post-out-{{run_id}}"}],"body":{"mode":"raw","raw":"{\"probe\":\"different-payload\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('issue payload conflict 409', () => pm.response.to.have.status(409));","pm.test('idempotency code', () => pm.expect(pm.response.json().error.code).to.eql('IDEMPOTENCY_ERROR'));"]}}]},{"name":"21 Different issue key double-post","request":{"method":"POST","url":"{{base_url}}/api/v1/outbound-documents/{{outbound_id}}/post-issue","header":[{"key":"Idempotency-Key","value":"wwhn180-post-out-second-{{run_id}}"}]},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('issue double-post 409', () => pm.response.to.have.status(409));","pm.test('state conflict', () => pm.expect(pm.response.json().error.code).to.eql('STATE_CONFLICT'));"]}}]},{"name":"22 Reconciliation manager","request":{"method":"GET","url":"{{base_url}}/api/v1/reports/inventory-reconciliation?warehouse_id={{warehouse_id}}&product_id={{product_id}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('reconcile 200', () => pm.response.to.have.status(200));","pm.test('reconcile PASS', () => pm.expect(pm.response.json().data.summary.status).to.eql('PASS'));","pm.test('no mismatch', () => pm.expect(pm.response.json().data.summary.mismatch_count).to.eql(0));"]}}]},{"name":"23 Reconciliation denied without permission","request":{"method":"GET","url":"{{base_url}}/api/v1/reports/inventory-reconciliation?warehouse_id={{warehouse_id}}&product_id={{product_id}}"},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{no_permission_token}}","type":"string"}]},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('reconcile denied 403', () => pm.response.to.have.status(403));","pm.test('access denied', () => pm.expect(pm.response.json().error.code).to.eql('ACCESS_DENIED'));"]}}]}]}
