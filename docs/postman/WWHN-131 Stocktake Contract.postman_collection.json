{
  "info": {
    "_postman_id": "a2d29d3c-90ec-45f2-a0bc-4c6b3ef6cb91",
    "name": "WWHN-131 Stocktake Contract",
    "description": "Executable PROPOSED contract for stocktake create/start/count/review/apply, idempotency and signed movement semantics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "01 Login manager",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"},
        "url": "{{baseUrl}}/api/v1/auth/login"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('login 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.environment.set('managerToken', body.data.access_token);",
        "pm.environment.set('runKey', 'stk-postman-' + Date.now());"
      ]}}]
    },
    {
      "name": "02 Select authoritative balance",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}],
        "url": "{{baseUrl}}/api/v1/inventory/balances?per_page=100"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('balance list 200', () => pm.response.to.have.status(200));",
        "const rows = pm.response.json().data;",
        "pm.expect(rows.length).to.be.above(0);",
        "const row = rows[0];",
        "pm.environment.set('warehouseId', row.warehouse_id);",
        "pm.environment.set('productId', row.product_id);",
        "pm.environment.set('actualQty', Number(row.on_hand_qty));"
      ]}}]
    },
    {
      "name": "03 Create DRAFT session",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{managerToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"warehouse_id\": \"{{warehouseId}}\",\n  \"session_no\": \"{{runKey}}\"\n}"},
        "url": "{{baseUrl}}/api/v1/stocktake-sessions"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('create 201', () => pm.response.to.have.status(201));",
        "const data = pm.response.json().data;",
        "pm.expect(data.status).to.eql('DRAFT');",
        "pm.expect(data.session_version).to.eql(1);",
        "pm.environment.set('sessionId', data.session_id);"
      ]}}]
    },
    {
      "name": "04 Start and snapshot",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{managerToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"session_version\": 1\n}"},
        "url": "{{baseUrl}}/api/v1/stocktake-sessions/{{sessionId}}/start"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('start 200', () => pm.response.to.have.status(200));",
        "const data = pm.response.json().data;",
        "pm.expect(data.session.status).to.eql('IN_PROGRESS');",
        "pm.expect(data.session.session_version).to.eql(2);",
        "pm.expect(data.snapshot_rows.SKU).to.be.above(0);"
      ]}}]
    },
    {
      "name": "05 Record SKU count",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{managerToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"lines\": [{\n    \"grain_type\": \"SKU\",\n    \"grain_id\": \"{{productId}}\",\n    \"product_id\": \"{{productId}}\",\n    \"stock_status\": \"AVAILABLE\",\n    \"actual_qty\": {{actualQty}}\n  }]\n}"},
        "url": "{{baseUrl}}/api/v1/stocktake-sessions/{{sessionId}}/counts"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('count 200', () => pm.response.to.have.status(200));",
        "pm.expect(pm.response.json().data.counts_created).to.eql(1);"
      ]}}]
    },
    {
      "name": "06 Review signed ledger",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{managerToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"session_version\": 2\n}"},
        "url": "{{baseUrl}}/api/v1/stocktake-sessions/{{sessionId}}/review"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('review 200', () => pm.response.to.have.status(200));",
        "const data = pm.response.json().data;",
        "pm.expect(data.session.status).to.eql('REVIEWED');",
        "pm.expect(data.variances.length).to.eql(1);",
        "pm.environment.set('varianceId', data.variances[0].variance_id);",
        "pm.environment.set('reviewedVersion', data.session.session_version);",
        "pm.expect(Number(data.variances[0].inventory_effect_qty)).to.eql(0);"
      ]}}]
    },
    {
      "name": "07 Apply missing idempotency key",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{managerToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"session_version\": {{reviewedVersion}},\n  \"variance_ids\": [\"{{varianceId}}\"],\n  \"reason\": \"Postman stocktake canonical\"\n}"},
        "url": "{{baseUrl}}/api/v1/stocktake-sessions/{{sessionId}}/apply-adjustment"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('missing key 428', () => pm.response.to.have.status(428));",
        "pm.expect(pm.response.json().error_code).to.eql('PRECONDITION_REQUIRED');"
      ]}}]
    },
    {
      "name": "08 Apply committed",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{managerToken}}"},
          {"key": "Idempotency-Key", "value": "{{runKey}}-apply"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"session_version\": {{reviewedVersion}},\n  \"variance_ids\": [\"{{varianceId}}\"],\n  \"reason\": \"Postman stocktake canonical\"\n}"},
        "url": "{{baseUrl}}/api/v1/stocktake-sessions/{{sessionId}}/apply-adjustment"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('apply 200', () => pm.response.to.have.status(200));",
        "const data = pm.response.json().data;",
        "pm.expect(data.status).to.eql('APPLIED');",
        "pm.expect(data.request_hash).to.match(/^[a-f0-9]{64}$/);",
        "pm.environment.set('requestHash', data.request_hash);"
      ]}}]
    },
    {
      "name": "09 Replay after commit",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{managerToken}}"},
          {"key": "Idempotency-Key", "value": "{{runKey}}-apply"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"session_version\": {{reviewedVersion}},\n  \"variance_ids\": [\"{{varianceId}}\"],\n  \"reason\": \"Postman stocktake canonical\"\n}"},
        "url": "{{baseUrl}}/api/v1/stocktake-sessions/{{sessionId}}/apply-adjustment"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('replay 200', () => pm.response.to.have.status(200));",
        "pm.expect(pm.response.json().message).to.contain('Replay');",
        "pm.expect(pm.response.json().data.request_hash).to.eql(pm.environment.get('requestHash'));"
      ]}}]
    },
    {
      "name": "10 Same key different payload",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{managerToken}}"},
          {"key": "Idempotency-Key", "value": "{{runKey}}-apply"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"session_version\": {{reviewedVersion}},\n  \"variance_ids\": [\"{{varianceId}}\"],\n  \"reason\": \"Payload changed\"\n}"},
        "url": "{{baseUrl}}/api/v1/stocktake-sessions/{{sessionId}}/apply-adjustment"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('payload conflict 409', () => pm.response.to.have.status(409));",
        "pm.expect(pm.response.json().error_code).to.eql('IDEMPOTENCY_ERROR');"
      ]}}]
    }
  ],
  "variable": []
}
