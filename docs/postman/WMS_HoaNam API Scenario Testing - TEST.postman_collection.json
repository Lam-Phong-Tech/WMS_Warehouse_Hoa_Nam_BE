                  "const json = pm.response.json();",
                  "pm.environment.set('defectId', json.data.defect_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"defect_code\":\"SMOKE-DEF-{{$timestamp}}\",\"defect_name\":\"Smoke Test Defect\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/defect-catalogs", "host": ["{{baseUrl}}"], "path": ["defect-catalogs"] }
          },
          "response": []
        },
        {
          "name": "List Defect Catalogs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('list status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/defect-catalogs?keyword=Smoke", "host": ["{{baseUrl}}"], "path": ["defect-catalogs"], "query": [{ "key": "keyword", "value": "Smoke" }] }
          },
          "response": []
        },
        {
          "name": "Update Defect Catalog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('update status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('status updated', function () { pm.expect(pm.response.json().data.status).to.eql('INACTIVE'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
