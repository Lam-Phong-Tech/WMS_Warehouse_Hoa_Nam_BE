{
  "info": {
    "name": "WMS_HoaNam API Scenario Testing - TEST",
    "description": "Smoke test cho npm run api:smoke (Newman). Login bang tai khoan admin da seed (AuthDatabaseSeeder, chi co o moi truong development); collection KHONG chua mat khau, truyen luc chay: --env-var adminPassword=<WMS_FIXTURE_PASSWORD>. Sau do goi tuan tu cac endpoint moi (Agency, Defect Catalog, Role, User) va tu don du lieu demo o cuoi moi folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "01. Authentication",
      "item": [
        {
          "name": "Login (admin)",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('access_token present', function () { pm.expect(json.data.access_token).to.be.a('string'); });",
                  "pm.environment.set('token', json.data.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "response": []
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('me status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('username = admin', function () { pm.expect(pm.response.json().data.username).to.eql('admin'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "16. Agency",
      "item": [
        {
          "name": "Create Agency",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create status 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.environment.set('agencyId', json.data.agency_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"agency_code\":\"SMOKE-AGY-{{$timestamp}}\",\"agency_name\":\"Smoke Test Agency\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/agencies", "host": ["{{baseUrl}}"], "path": ["agencies"] }
          },
          "response": []
        },
        {
          "name": "List Agencies",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('list status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/agencies?keyword=Smoke", "host": ["{{baseUrl}}"], "path": ["agencies"], "query": [{ "key": "keyword", "value": "Smoke" }] }
          },
          "response": []
        },
        {
          "name": "Update Agency",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('update status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('name updated', function () { pm.expect(pm.response.json().data.agency_name).to.eql('Smoke Test Agency Updated'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"agency_name\":\"Smoke Test Agency Updated\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/agencies/{{agencyId}}", "host": ["{{baseUrl}}"], "path": ["agencies", "{{agencyId}}"] }
          },
          "response": []
        },
        {
          "name": "Cleanup - Delete Agency",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('delete status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/agencies/{{agencyId}}", "host": ["{{baseUrl}}"], "path": ["agencies", "{{agencyId}}"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "17. Defect Catalog",
      "item": [
        {
          "name": "Create Defect Catalog",
          "event": [
