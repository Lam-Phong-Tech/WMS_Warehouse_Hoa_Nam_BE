          },
          "response": []
        },
        {
          "name": "Cleanup - Delete Defect Catalog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('delete status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/defect-catalogs/{{defectId}}", "host": ["{{baseUrl}}"], "path": ["defect-catalogs", "{{defectId}}"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03. Roles",
      "item": [
        {
          "name": "Create Role",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create status 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.environment.set('roleId', json.data.role_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"role_code\":\"SMOKE_ROLE_{{$timestamp}}\",\"role_name\":\"Smoke Test Role\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/roles", "host": ["{{baseUrl}}"], "path": ["roles"] }
          },
          "response": []
        },
        {
          "name": "Get Permission (warehouse.view)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('list permissions status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('permission found', function () { pm.expect(json.data.length).to.be.above(0); });",
                  "pm.environment.set('permissionId', json.data[0].permission_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/permissions?keyword=warehouse.view", "host": ["{{baseUrl}}"], "path": ["permissions"], "query": [{ "key": "keyword", "value": "warehouse.view" }] }
          },
          "response": []
        },
        {
          "name": "Assign Permissions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('assign status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"permission_ids\":[\"{{permissionId}}\"]}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/roles/{{roleId}}/permissions", "host": ["{{baseUrl}}"], "path": ["roles", "{{roleId}}", "permissions"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02. Users",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// One-time password for the smoke user: generated per run, never stored in the collection.",
                  "const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789';",
                  "const random = Array.from({ length: 16 }, () => alphabet[Math.floor(Math.random() * alphabet.length)]).join('');",
                  "pm.variables.set('smokeUserPassword', 'Smoke#' + random + '9a');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create status 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('password_hash not leaked', function () { pm.expect(json.data.password_hash).to.be.undefined; });",
                  "pm.environment.set('userId', json.data.user_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"smoke_user_{{$timestamp}}\",\"display_name\":\"Smoke User\",\"password\":\"{{smokeUserPassword}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          },
          "response": []
        },
        {
          "name": "Get Existing Role (VIEWER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('list roles status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('viewer role found', function () { pm.expect(json.data.length).to.be.above(0); });",
                  "pm.environment.set('existingRoleId', json.data[0].role_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/roles?keyword=VIEWER", "host": ["{{baseUrl}}"], "path": ["roles"], "query": [{ "key": "keyword", "value": "VIEWER" }] }
          },
          "response": []
        },
        {
          "name": "Assign Roles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('assign status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"role_ids\":[\"{{existingRoleId}}\"]}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/users/{{userId}}/roles", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}", "roles"] }
          },
          "response": []
        },
        {
          "name": "Cleanup - Delete User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('delete status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "99. Cleanup",
