{
  "info": {
    "_postman_id": "4dbf6b5a-7e8d-4f5c-b0fb-fdb8c6ee3511",
    "name": "WMS HoaNam API Contract - DEV",
    "description": "Generated-compatible contract collection. Trạng thái phê duyệt do reviewer xác nhận trên PR/Jira; collection không tự gắn APPROVED.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": {"major": 1, "minor": 1, "patch": 0}
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080", "type": "string"},
    {"key": "email", "value": "", "type": "string"},
    {"key": "password", "value": "", "type": "string"},
    {"key": "accessToken", "value": "", "type": "string"},
    {"key": "refreshToken", "value": "", "type": "string"}
  ],
  "item": [
    {
      "name": "01. Authentication",
      "item": [
        {
          "name": "Login",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('Envelope chuẩn', () => { pm.expect(body.success).to.eql(true); pm.expect(body.meta.request_id).to.be.a('string'); });",
            "pm.test('Token contract', () => { pm.expect(body.data.access_token).to.be.a('string'); pm.expect(body.data.refresh_token).to.be.a('string'); });",
            "pm.collectionVariables.set('accessToken', body.data.access_token);",
            "pm.collectionVariables.set('refreshToken', body.data.refresh_token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Accept", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"]}
          }
        },
        {
          "name": "Me",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('Authorization payload', () => { pm.expect(body.data.roles).to.be.an('array'); pm.expect(body.data.permissions).to.be.an('array'); pm.expect(body.data).to.have.property('warehouse_scope_ids'); });"
          ]}}],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"]}
          }
        },
        {
          "name": "Refresh - rotate",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('Refresh token được xoay vòng', () => pm.expect(body.data.refresh_token).to.not.eql(pm.collectionVariables.get('refreshToken')));",
            "pm.collectionVariables.set('oldRefreshToken', pm.collectionVariables.get('refreshToken'));",
            "pm.collectionVariables.set('refreshToken', body.data.refresh_token);",
            "pm.collectionVariables.set('accessToken', body.data.access_token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Accept", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh"]}
          }
        },
        {
          "name": "Refresh replay - expected 401",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
            "pm.test('Replay bị từ chối', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Accept", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"refresh_token\": \"{{oldRefreshToken}}\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh"]}
          }
        },
        {
          "name": "Logout",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.unset('accessToken');",
            "pm.collectionVariables.unset('refreshToken');",
            "pm.collectionVariables.unset('oldRefreshToken');"
          ]}}],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Accept", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "logout"]}
          }
        }
      ]
    },
    {
      "name": "99. Negative Contract",
      "item": [
        {
          "name": "Login invalid credentials - 401",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
            "pm.test('Không rò rỉ trace', () => { const b = pm.response.json(); pm.expect(b.error.code).to.eql('UNAUTHENTICATED'); pm.expect(b).to.not.have.property('trace'); });"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Accept", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"invalid@example.com\",\n  \"password\": \"invalid\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"]}
          }
        },
        {
          "name": "Refresh missing token - 422",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('HTTP 422', () => pm.response.to.have.status(422));",
            "pm.test('Envelope lỗi chuẩn', () => pm.expect(pm.response.json().error.details).to.be.an('object'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Accept", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{}"},
            "url": {"raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh"]}
          }
        },
        {
          "name": "Me without token - 401",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
            "pm.test('UNAUTHENTICATED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"]}
          }
        }
      ]
    }
  ]
}
