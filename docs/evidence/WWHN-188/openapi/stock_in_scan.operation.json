        "description": "Optimistic locking theo cột version của resource. Thiếu header khi endpoint bắt buộc: 428 PRECONDITION_REQUIRED. Sai version: 412 STALE_VERSION.",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      }
    ],
    "requestBody": {
      "required": false,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "example": {},
            "additionalProperties": true
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Thành công",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiSuccessEnvelope"
            }
          }
        }
      },
      "400": {
        "description": "Yêu cầu không đúng định dạng",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "401": {
        "description": "Chưa xác thực",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "403": {
        "description": "Không có quyền truy cập",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "404": {
        "description": "Không tìm thấy tài nguyên hoặc nằm ngoài phạm vi dữ liệu",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "409": {
        "description": "Xung đột trạng thái, nghiệp vụ, idempotency hoặc thao tác đồng thời",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "412": {
        "description": "Điều kiện If-Match không đạt",
        "content": {
