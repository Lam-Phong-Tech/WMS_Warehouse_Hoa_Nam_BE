{
  "/api/v1/inbound-documents/{id}/scan": {
    "tags": [
      "09. Stock In (Inbound)"
    ],
    "summary": "Quét hàng cho phiếu DRAFT/SCANNING (stock-neutral)",
    "description": "Bắt buộc If-Match. Scan hợp lệ chuyển/giữ phiếu ở SCANNING, tăng scanned_qty nhưng không tạo stock movement và không đổi inventory balance. Scan vượt Expected bị từ chối. Idempotency-Key là TÙY CHỌN (scan stock-neutral, Annex C không khai bắt buộc nên thiếu header KHÔNG trả 428) — xem DEC-SCAN-IDEMP-001. Khi client gửi Idempotency-Key: mỗi hành động quét sinh một key và mọi lần gửi lại của đúng hành động đó dùng lại đúng key. Cùng key + cùng nội dung scan (line_id, qty, code_value, item_id, container_id) trả lại đúng response cũ kèm data.replayed=true và header Idempotent-Replay: true, scanned_qty KHÔNG tăng lần hai kể cả khi If-Match là version mới sau khi client re-fetch. Cùng key + khác nội dung scan trả 409 IDEMPOTENCY_CONFLICT. Khác key + cùng nội dung là lần quét thật thứ hai và vẫn cộng dồn bình thường. Fingerprint dedupe là tất định trên nội dung scan, không chứa version và không dùng cửa sổ thời gian; qty và quantity là alias của cùng một trường nên không tạo xung đột payload.",
    "operationId": "stock_in_scan",
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      {
        "name": "Idempotency-Key",
        "in": "header",
        "description": "Tùy chọn (DEC-SCAN-IDEMP-001). Độ dài 8..100 ký tự sau khi trim; sai độ dài trả 422 VALIDATION_ERROR. Thiếu header thì giữ nguyên hành vi cũ, không trả 428.",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 100,
          "minLength": 8
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "required": [
              "line_id",
              "qty"
            ],
            "properties": {
              "line_id": {
                "type": "string",
                "format": "uuid"
              },
              "qty": {
                "type": "integer",
                "example": 1,
                "minimum": 1
              },
              "code_value": {
                "type": "string",
                "nullable": true
              },
              "item_id": {
                "type": "string",
                "format": "uuid",
                "nullable": true
              },
              "container_id": {
                "type": "string",
                "format": "uuid",
                "nullable": true
              }
            },
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Scan hợp lệ; stock_effect=NONE. data.replayed=false là lần áp dụng thật, true là replay của một request đã chạy trước đó với cùng Idempotency-Key (header Idempotent-Replay phản chiếu cùng giá trị).",
        "headers": {
          "ETag": {
            "description": "Version hiện hành của phiếu sau khi scan.",
            "schema": {
              "type": "string"
            }
          },
          "Idempotent-Replay": {
            "description": "true khi response là replay theo Idempotency-Key.",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiSuccessEnvelope"
            }
          }
        }
      },
      "400": {
        "description": "Yêu cầu không đúng định dạng",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "401": {
        "description": "Chưa xác thực",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "403": {
        "description": "Không có permission inbound.scan",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "404": {
        "description": "Không tìm thấy chứng từ/dòng",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "409": {
        "description": "STATE_CONFLICT (phiếu không còn DRAFT/SCANNING) | DUPLICATE_ITEM_IN_DOCUMENT | ITEM_ALREADY_RECEIVING | IDEMPOTENCY_CONFLICT (cùng Idempotency-Key nhưng khác nội dung scan) | CONCURRENCY_CONFLICT (cùng key đang được xử lý)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "412": {
        "description": "If-Match không khớp",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "422": {
        "description": "Scan sai SKU/mã/BOX, vượt Expected, hoặc Idempotency-Key sai độ dài 8..100",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "428": {
        "description": "Thiếu If-Match",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "500": {
        "description": "Lỗi hệ thống ngoài dự kiến; giao dịch đã được rollback",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      }
    },
    "security": [
      {
        "bearerAuth": []
      }
    ]
  },
  "/api/v1/inbound-documents/{id}/scans": {
    "tags": [
      "09. Stock In (Inbound)"
    ],
    "summary": "Quét hàng cho phiếu nhập (Annex C)",
    "operationId": "post_api_v1_inbound__documents_id_scans",
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "Idempotency-Key",
        "in": "header",
        "description": "Tuỳ chọn. Nếu gửi thì vẫn được kiểm độ dài 8-100 và đi qua cơ chế replay/conflict.",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 100,
          "minLength": 8
