              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "428": {
        "description": "Thiếu điều kiện If-Match bắt buộc",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      },
      "500": {
        "description": "Lỗi hệ thống ngoài dự kiến; giao dịch đã được rollback",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelope"
            }
          }
        }
      }
    },
    "security": [
