    {
      "id": "HLT-004",
      "level": "security",
      "scenario": "Invalid X-Request-ID",
      "expected": "Server replaces it and uses one consistent ID"
    },
    {
      "id": "HLT-005",
      "level": "compatibility",
      "scenario": "GET /api/health",
      "expected": "HTTP 404"
    },
    {
      "id": "HLT-006",
      "level": "method-safety",
      "scenario": "POST/PUT/DELETE canonical health",
      "expected": "HTTP 405"
    },
    {
      "id": "HLT-007",
      "level": "database",
      "scenario": "Query seed markers",
      "expected": "admin, warehouse and product markers exist exactly once"
    }
