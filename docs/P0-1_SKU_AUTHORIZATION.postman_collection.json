    {
      "name": "📁 403 Response Examples",
      "item": [
        {
          "name": "Example 1: 403 ACCESS_DENIED - No Permission",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_no_permission}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/products",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403', () => pm.expect(pm.response.code).to.eql(403));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('success is false', () => pm.expect(json.success).to.be.false);",
                  "pm.test('error_code is ACCESS_DENIED', () => pm.expect(json.error_code).to.eql('ACCESS_DENIED'));",
                  "pm.test('error.code is ACCESS_DENIED', () => pm.expect(json.error.code).to.eql('ACCESS_DENIED'));",
                  "pm.test('error.details is empty array', () => pm.expect(json.error.details).to.be.an('array').that.is.empty);",
                  "pm.test('Has X-Request-ID header', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.exist);",
                  "pm.test('No trace in response', () => pm.expect(json).to.not.have.property('trace'));",
                  "pm.test('No stack in response', () => pm.expect(json).to.not.have.property('stack'));",
                  "",
                  "console.log('403 Response:', JSON.stringify(json, null, 2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Example 2: 403 ACCESS_DENIED - Wrong Permission",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_master_manager}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/products",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403', () => pm.expect(pm.response.code).to.eql(403));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('error_code matches error.code', () => pm.expect(json.error_code).to.eql(json.error.code));",
                  "pm.test('Has meta with request_id', () => pm.expect(json.meta).to.have.property('request_id'));",
                  "pm.test('Has meta with timestamp', () => pm.expect(json.meta).to.have.property('timestamp'));",
                  "",
                  "console.log('403 Response:', JSON.stringify(json, null, 2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Example 3: 401 UNAUTHENTICATED - No Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/products",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.expect(pm.response.code).to.eql(401));",
                  "pm.test('error_code is UNAUTHENTICATED', () => pm.expect(pm.response.json().error_code).to.eql('UNAUTHENTICATED'));",
                  "pm.test('Has X-Request-ID header', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.exist);",
                  "",
                  "console.log('401 Response:', JSON.stringify(pm.response.json(), null, 2));"
                ]
              }
            }
          ]
        }
      ]
