{
  "openapi": "3.1.0",
  "info": {"title": "P12 B12 Mixed Document List", "version": "p12-mixed-documents-v3", "description": "Official read-only All-tab aggregate. Source-qualified canonical status, Mini App status and readiness are server-owned. FE must not merge owner pages. Deployment and live acceptance remain separate."},
  "paths": {
    "/api/v1/mini-app/documents": {
      "get": {
        "operationId": "p12MixedDocumentList",
        "summary": "One time-interleaved list of authorized inbound, outbound and warranty records",
        "description": "No request body or unknown query parameters. The runtime flag defaults OFF. Confirm the server warehouse context before reading. Omit cursor on first page; start is a compatibility alias. A source failure returns no partial list or total.",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"name": "warehouse_id", "in": "query", "required": false, "description": "Optional assertion, must equal confirmed session warehouse; not a scope selector.", "schema": {"type": "string", "format": "uuid"}},
          {"name": "source", "in": "query", "schema": {"type": "string", "enum": ["ALL", "INBOUND", "OUTBOUND", "WARRANTY"], "default": "ALL"}},
          {"name": "web_queue", "in": "query", "description": "p13-web-post-queue-v1: persisted RECORD handoff plus canonical current nonterminal stock state, not readiness/receipt inference. Filter before counts/cursor. WARRANTY is not a stock POST queue.", "schema": {"type": "string", "enum": ["ALL", "WAITING_WEB_POST"], "default": "ALL"}},
          {"name": "q", "in": "query", "description": "Unicode NFC lowercase literal contains, accent-sensitive. At most 200 normalized characters; raw limit 600. Search canonical codes, explicit source type terms and stock partner fields. Warranty customer/free-text fields are excluded.", "schema": {"type": "string", "maxLength": 600, "default": ""}},
          {"name": "keyword", "in": "query", "deprecated": true, "description": "Alias for q from candidate v1; conflicting normalized q/keyword is 422.", "schema": {"type": "string", "maxLength": 600}},
          {"name": "status", "in": "query", "schema": {"type": "string", "default": "ALL", "enum": ["ALL", "INBOUND:DRAFT", "INBOUND:SCANNING", "INBOUND:POSTED", "INBOUND:CANCELLED", "OUTBOUND:DRAFT", "OUTBOUND:SCANNING", "OUTBOUND:POSTED", "OUTBOUND:CANCELLED", "WARRANTY:RECEIVED", "WARRANTY:CHECKING", "WARRANTY:REPAIRING", "WARRANTY:COMPLETED", "WARRANTY:RETURNED", "WARRANTY:CANCELLED"]}},
          {"name": "date_from", "in": "query", "description": "Required with date_to, otherwise omit. Between Vietnam today minus 90 days and today, inclusive. Uses created_at for every source.", "schema": {"type": "string", "format": "date"}},
          {"name": "date_to", "in": "query", "description": "Required with date_from, from<=to. Inclusive local day implemented using next midnight exclusive. Existing cursor keeps its original window anchor.", "schema": {"type": "string", "format": "date"}},
          {"name": "timezone", "in": "query", "schema": {"type": "string", "enum": ["Asia/Ho_Chi_Minh"], "default": "Asia/Ho_Chi_Minh"}},
          {"name": "sort", "in": "query", "description": "NULLS LAST; source_rank ASC then canonical ID ASC in either time direction.", "schema": {"type": "string", "enum": ["created_at_asc", "created_at_desc"], "default": "created_at_desc"}},
          {"name": "per_page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}},
          {"name": "cursor", "in": "query", "description": "Opaque authenticated cursor, fixed TTL 900s. Bound to query/actor/session/warehouse/permissions. v1 cursors cannot be reused.", "schema": {"type": "string", "minLength": 1, "maxLength": 4096}}
        ],
        "responses": {
          "200": {"description": "Complete current-request authorized result, not a frozen cross-request snapshot.", "headers": {"Cache-Control": {"schema": {"type": "string", "example": "private, no-store"}}, "X-Content-Type-Options": {"schema": {"type": "string", "const": "nosniff"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DocumentList"}}}},
          "401": {"$ref": "#/components/responses/ReadError"},
          "403": {"$ref": "#/components/responses/ReadError"},
          "409": {"$ref": "#/components/responses/ReadError"},
          "410": {"$ref": "#/components/responses/ReadError"},
          "422": {"$ref": "#/components/responses/ReadError"},
          "503": {"$ref": "#/components/responses/ReadError"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}},
    "responses": {"ReadError": {"description": "401 unauthenticated/expired; 403 denied; 409 context/cursor binding changed; 410 expired cursor; 422 invalid query/body/cursor/date; 503 disabled/unavailable owner source. No partial data or numeric total.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}},
    "schemas": {
      "Source": {"type": "string", "enum": ["INBOUND", "OUTBOUND", "WARRANTY"]},
      "WebPostHandoff": {"type": "object", "required": ["contract", "state", "current_waiting_for_web", "source", "warehouse_id", "submitted_at", "document_version_at_record", "reviewed_at", "reviewed_status", "posted_at", "stock_effect"], "properties": {"contract": {"const": "p13-web-post-queue-v1"}, "state": {"enum": ["WAITING_WEB_POST", "POSTED", "CANCELLED", "UNKNOWN"]}, "current_waiting_for_web": {"type": ["boolean", "null"]}, "source": {"const": "mini_app_web_post_handoffs+stock_documents.status"}, "warehouse_id": {"type": "string", "format": "uuid"}, "submitted_at": {"type": "string", "format": "date-time"}, "document_version_at_record": {"type": "integer", "minimum": 1}, "reviewed_at": {"type": "null"}, "reviewed_status": {"const": "NOT_RECORDED"}, "posted_at": {"type": ["string", "null"], "format": "date-time"}, "stock_effect": {"const": "READ_ONLY_PROJECTION"}}, "additionalProperties": false},
      "ReadTarget": {"type": "object", "required": ["method", "path", "query"], "properties": {"method": {"const": "GET"}, "path": {"type": "string", "pattern": "^/api/v1/mini-app/(inbound-documents|outbound-documents|warranty-cases)/[0-9a-f-]{36}$"}, "query": {"type": "object", "required": ["warehouse_id"], "properties": {"warehouse_id": {"type": "string", "format": "uuid"}}, "additionalProperties": false}}, "additionalProperties": false},
      "Identity": {"type": "object", "required": ["id", "source", "resource_type", "warehouse_id"], "properties": {"id": {"type": "string", "format": "uuid"}, "source": {"$ref": "#/components/schemas/Source"}, "resource_type": {"type": "string", "enum": ["STOCK_DOCUMENT", "WARRANTY_CASE"]}, "warehouse_id": {"type": "string", "format": "uuid"}}, "additionalProperties": false},
      "Partner": {"type": "object", "required": ["display_name", "availability", "redacted"], "properties": {"display_name": {"type": ["string", "null"]}, "availability": {"enum": ["RECORDED", "NOT_RECORDED", "WITHHELD_IN_AGGREGATE"]}, "redacted": {"type": "boolean"}}, "additionalProperties": false},
      "DisplayStatus": {"type": "object", "required": ["value", "label", "availability", "mapping_contract", "source"], "properties": {"value": {"type": ["string", "null"]}, "label": {"type": "string"}, "availability": {"const": "MAPPED"}, "mapping_contract": {"const": "p12-p13-p16-status-v1"}, "source": {"type": "string"}}, "additionalProperties": false},
      "DocumentRow": {
        "type": "object",
        "required": ["id", "row_key", "source", "resource_type", "document_no", "warehouse_id", "created_at", "timestamp_source", "time_status", "status", "canonical_status", "source_status", "status_key", "mini_app_status", "readiness", "display_status", "partner", "p12", "read_target"],
        "properties": {
          "id": {"type": "string", "format": "uuid"}, "row_key": {"type": "string", "pattern": "^(INBOUND|OUTBOUND|WARRANTY):[0-9a-f-]{36}$"}, "source": {"$ref": "#/components/schemas/Source"},
          "resource_type": {"enum": ["STOCK_DOCUMENT", "WARRANTY_CASE"]}, "document_no": {"type": ["string", "null"]}, "warehouse_id": {"type": "string", "format": "uuid"},
          "created_at": {"type": ["string", "null"], "format": "date-time"}, "timestamp_source": {"enum": ["stock_documents.created_at", "warranty_case.created_at"]}, "time_status": {"enum": ["RECORDED", "NOT_RECORDED"]},
          "status": {"type": ["string", "null"]}, "canonical_status": {"type": ["string", "null"]}, "source_status": {"type": ["string", "null"]}, "status_key": {"type": ["string", "null"]}, "mini_app_status": {"type": ["string", "null"]}, "readiness": {"type": "object", "required": ["state", "applicable", "ready_for_post", "ready_for_issue", "can_post", "blockers", "source"], "properties": {"state": {"enum": ["UNKNOWN", "IN_PROGRESS", "READY", "BLOCKED", "TERMINAL", "OWNER_STATUS_ONLY"]}, "applicable": {"type": "boolean"}, "ready_for_post": {"type": ["boolean", "null"]}, "ready_for_issue": {"type": ["boolean", "null"]}, "can_post": {"type": ["boolean", "null"]}, "blockers": {"type": "array", "items": {"type": "string"}}, "source": {"type": "string"}}, "additionalProperties": false},
          "display_status": {"$ref": "#/components/schemas/DisplayStatus"}, "partner": {"$ref": "#/components/schemas/Partner"},
          "p12": {"type": "object", "required": ["identity", "read_target", "status"], "properties": {"identity": {"$ref": "#/components/schemas/Identity"}, "read_target": {"$ref": "#/components/schemas/ReadTarget"}, "status": {"type": "object", "required": ["canonical", "mini_app", "readiness", "waiting_for_web"], "properties": {"canonical": {"type": ["string", "null"]}, "mini_app": {"type": ["string", "null"]}, "readiness": {"type": "object"}, "waiting_for_web": {"type": "null"}}}}},
          "read_target": {"$ref": "#/components/schemas/ReadTarget"},
          "web_post_handoff": {"oneOf": [{"type": "null"}, {"$ref": "#/components/schemas/WebPostHandoff"}]}
        },
        "additionalProperties": false
      },
      "Facet": {"type": "object", "required": ["availability", "total"], "properties": {"availability": {"enum": ["READY", "DENIED"]}, "total": {"type": ["integer", "null"], "minimum": 0}}, "allOf": [{"if": {"properties": {"availability": {"const": "DENIED"}}}, "then": {"properties": {"total": {"type": "null"}}}, "else": {"properties": {"total": {"type": "integer"}}}}], "additionalProperties": false},
      "Metadata": {
        "type": "object",
        "required": ["contract", "timestamp_contract", "cursor_version", "warehouse_id", "warehouse_context", "source", "total", "count_unit", "per_page", "returned_count", "hasMore", "has_more", "nextCursor", "next_cursor", "pagination_mode", "cursor_ttl_seconds", "cursor_expires_at", "upper_bound_created_at", "source_facets", "allowed_sources", "source_failure_policy", "filter_options", "status_filter_keys", "date_window", "sort", "tie_break", "cache_policy", "write_operations"],
        "properties": {
          "contract": {"const": "p12-mixed-documents-v3"}, "timestamp_contract": {"const": "document-timestamps-v1"}, "cursor_version": {"const": 3},
          "warehouse_id": {"type": "string", "format": "uuid"}, "warehouse_context": {"type": "object", "required": ["status", "source"], "properties": {"status": {"const": "READY"}, "source": {"const": "CONFIRMED_SERVER_SESSION"}}, "additionalProperties": false},
          "source": {"enum": ["ALL", "INBOUND", "OUTBOUND", "WARRANTY"]}, "total": {"type": "integer", "minimum": 0}, "count_unit": {"const": "DOCUMENT_LIST_RECORD"}, "per_page": {"type": "integer", "minimum": 1, "maximum": 100},
          "returned_count": {"type": "integer", "minimum": 0, "maximum": 100}, "hasMore": {"type": "boolean"}, "has_more": {"type": "boolean"}, "nextCursor": {"type": ["string", "null"]}, "next_cursor": {"type": ["string", "null"]},
          "pagination_mode": {"const": "KEYSET"}, "cursor_ttl_seconds": {"const": 900}, "cursor_expires_at": {"type": "string", "format": "date-time"}, "upper_bound_created_at": {"type": ["string", "null"], "format": "date-time"},
          "snapshot_consistent": {"const": false}, "cross_request_snapshot": {"const": false},
          "source_facets": {"type": "object", "required": ["ALL", "INBOUND", "OUTBOUND", "WARRANTY"], "properties": {"ALL": {"$ref": "#/components/schemas/Facet"}, "INBOUND": {"$ref": "#/components/schemas/Facet"}, "OUTBOUND": {"$ref": "#/components/schemas/Facet"}, "WARRANTY": {"$ref": "#/components/schemas/Facet"}}, "additionalProperties": false},
          "allowed_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/components/schemas/Source"}},
          "source_failure_policy": {"const": "FAIL_CLOSED_NO_PARTIAL_DATA_OR_TOTAL"}, "source_mapping_contract": {"type": "string"}, "status_filter_keys": {"type": "array", "items": {"type": "string"}},
          "filter_options": {"type": "object", "required": ["status", "display_mapping_approval"], "properties": {"status": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["value", "label", "source", "source_status", "label_availability", "display_label"], "properties": {"value": {"type": "string"}, "label": {"type": "string"}, "source": {"type": "string"}, "source_status": {"type": "string"}, "label_availability": {"type": "string"}, "display_label": {"type": "string"}}}}, "display_mapping_approval": {"const": "APPROVED"}}},
          "date_window": {"type": "object", "required": ["min", "max", "timezone", "anchor", "all_dates_unbounded_below", "end_bound"], "properties": {"min": {"type": "string", "format": "date"}, "max": {"type": "string", "format": "date"}, "timezone": {"const": "Asia/Ho_Chi_Minh"}, "anchor": {"const": "CURSOR_FIRST_REQUEST_VIETNAM_DATE"}, "all_dates_unbounded_below": {"const": true}, "end_bound": {"const": "NEXT_LOCAL_DAY_EXCLUSIVE"}}},
          "sort": {"enum": ["created_at_asc", "created_at_desc"]}, "tie_break": {"type": "object", "required": ["source_rank", "id"], "properties": {"source_rank": {"const": "asc"}, "id": {"const": "asc"}}},
          "cache_policy": {"const": "NO_INTERNAL_RESULT_CACHE"}, "write_operations": {"type": "null"}
        }
      },
      "DocumentList": {"type": "object", "required": ["success", "data", "meta"], "properties": {"success": {"const": true}, "data": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/DocumentRow"}}, "meta": {"$ref": "#/components/schemas/Metadata"}}},
      "Error": {"type": "object", "required": ["success", "error_code"], "properties": {"success": {"const": false}, "error_code": {"type": "string"}, "message": {"type": "string"}}, "not": {"required": ["data"]}}
    }
  }
}
