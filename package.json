{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "node scripts/verify-frontend-baseline.mjs",
        "test": "node scripts/verify-frontend-baseline.mjs && node scripts/verify-inventory-reconciliation-selftest.mjs",
        "health:contract": "node scripts/verify-frontend-baseline.mjs",
        "api:lint": "redocly lint storage/api-docs/api-docs.json",
        "api:mini-app-contract": "node scripts/verify-mini-app-swagger.mjs",
        "api:postman": "openapi2postmanv2 -s storage/api-docs/api-docs.json -o \"docs/postman/WMS_HoaNam API Contract - DEV.postman_collection.json\" -p -O folderStrategy=Tags",
        "api:smoke": "newman run \"docs/postman/WMS_HoaNam API Scenario Testing - TEST.postman_collection.json\" -e \"docs/postman/WMS_HoaNam - Local.postman_environment.json\""
    },
    "devDependencies": {
        "@redocly/cli": "^2.38.0",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "js-yaml": "^4.3.2",
        "laravel-vite-plugin": "^3.1",
        "newman": "^6.2.2",
        "openapi-to-postmanv2": "^6.3.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "overrides": {
        "nanoid": "^3.3.18",
        "js-yaml": "^4.3.2",
        "fast-uri": "^3.1.8",
        "qs": "^6.16.0",
        "uuid": "^11.1.1",
        "lodash": "^4.18.0",
        "handlebars": "4.7.10",
        "node-forge": "^1.4.0",
        "openapi-to-postmanv2": {
            "yaml": "^1.10.3"
        },
        "flatted": "^3.4.4",
        "underscore": "^1.13.8",
        "jose": "^4.15.5",
        "shell-quote": "1.11.0"
    }
}
