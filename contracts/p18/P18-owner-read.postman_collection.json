{"info":{"name":"P18 - Owner attachment reads and upload reconciliation only","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json","description":"Contract owner-attachment-upload-v1. Select ONE read_id and explicitly approved environment/account/parent/original upload. All variables empty and gates OFF. Do not create test data, login, refresh, upload, hand over, cancel or download binary using this collection. Requires Postman runtime with pm.execution.skipRequest. Automatic redirects OFF. access_token belongs only in the local environment, never export it. A passing/skipped collection is not deployment/live/UI approval. Lists are not upload receipts. New-login receipt recovery and reupload while UNKNOWN are not supported."},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{access_token}}","type":"string"}]},"protocolProfileBehavior":{"followRedirects":false},"variable":[{"key":"api_origin","value":""},{"key":"approved_api_origin","value":""},{"key":"read_id","value":""},{"key":"parent_type","value":""},{"key":"parent_id","value":""},{"key":"warehouse_id","value":""},{"key":"actor_id","value":""},{"key":"auth_session_id","value":""},{"key":"current_auth_session_id","value":""},{"key":"operation_key","value":""},{"key":"file_sha256","value":""},{"key":"original_upload_contract","value":""},{"key":"expected_http_status","value":""},{"key":"expected_error_code","value":""},{"key":"expected_outcome","value":""},{"key":"live_read_authorized","value":"false"},{"key":"owner_gate_authorized","value":"false"}],"event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["const v = key => String(pm.variables.get(key) || '');","const stop = () => { pm.execution.skipRequest(); throw new Error('P18 read blocked: verify approved owner, scope, session and original upload identity.'); };","const specs = {","  P01_ME: ['AUTH', '/api/v1/auth/me'],","  INBOUND_LIST: ['INBOUND', '/api/v1/mini-app/inbound-documents/' + v('parent_id') + '/attachments?page=1&per_page=20'],","  OUTBOUND_LIST: ['OUTBOUND', '/api/v1/mini-app/outbound-documents/' + v('parent_id') + '/attachments?page=1&per_page=20'],","  WARRANTY_LIST: ['WARRANTY', '/api/v1/mini-app/warranty-cases/' + v('parent_id') + '/attachments?warehouse_id=' + v('warehouse_id') + '&page=1&per_page=20'],","  INBOUND_RECONCILE: ['INBOUND', '/api/v1/mini-app/inbound-documents/' + v('parent_id') + '/attachments/requests/' + v('operation_key') + '?warehouse_id=' + v('warehouse_id') + '&file_sha256=' + v('file_sha256')],","  OUTBOUND_RECONCILE: ['OUTBOUND', '/api/v1/mini-app/outbound-documents/' + v('parent_id') + '/attachments/requests/' + v('operation_key') + '?warehouse_id=' + v('warehouse_id') + '&file_sha256=' + v('file_sha256')],","  WARRANTY_RECONCILE: ['WARRANTY', '/api/v1/mini-app/warranty-cases/' + v('parent_id') + '/attachments/requests/' + v('operation_key') + '?warehouse_id=' + v('warehouse_id') + '&file_sha256=' + v('file_sha256')]","};","const name = pm.info.requestName;","const spec = specs[name];","if (v('read_id') !== name || !spec) stop();","if (v('live_read_authorized') !== 'true' || v('owner_gate_authorized') !== 'true') stop();","if (pm.request.method !== 'GET' || pm.request.body) stop();","const origin = 'https://khohoanamdev.lptech.info.vn';","if (v('api_origin') !== origin || v('approved_api_origin') !== origin) stop();","if (pm.variables.replaceIn(pm.request.url.toString()) !== origin + spec[1]) stop();","const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;","if (!v('access_token') || /[\\r\\n]/.test(v('access_token'))) stop();","if (!['200','401','403','404','409','422','503'].includes(v('expected_http_status'))) stop();","if (v('expected_http_status') !== '200' && !v('expected_error_code')) stop();","if (spec[0] !== 'AUTH') {","  if (v('parent_type') !== spec[0]) stop();","  for (const key of ['parent_id','warehouse_id','actor_id','auth_session_id','current_auth_session_id']) if (!uuid.test(v(key))) stop();","  if (v('auth_session_id') !== v('current_auth_session_id')) stop();","}","if (name.endsWith('_RECONCILE')) {","  if (v('original_upload_contract') !== 'owner-attachment-upload-v1') stop();","  if (!uuid.test(v('operation_key')) || !/^[a-f0-9]{64}$/.test(v('file_sha256'))) stop();","  if (v('expected_http_status') === '200' && !['SUCCEEDED','REJECTED','UNKNOWN'].includes(v('expected_outcome'))) stop();","}","const trace = pm.variables.replaceIn('{{$guid}}');","if (!uuid.test(trace) || trace === v('operation_key')) stop();","pm.variables.set('p18_read_trace', trace);","// This script never uploads, logs in, switches context, writes tags or schedules another request."]}},{"listen":"test","script":{"type":"text/javascript","exec":["const v = key => String(pm.variables.get(key) || '');","const id = pm.info.requestName;","pm.test('Exact HTTP status, not an inferred upload result', () => pm.expect(pm.response.code).to.eql(Number(v('expected_http_status'))));","pm.test('Owner JSON and exact identity; no false success from list/bytes/hash', () => {","  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');","  const b = pm.response.json();","  if (pm.response.code !== 200) { pm.expect(b.success).to.eql(false); pm.expect(b.error.code).to.eql(v('expected_error_code')); return; }","  pm.expect(b.success).to.eql(true);","  if (!id.endsWith('_RECONCILE')) return;","  pm.expect(b.meta.contract).to.eql('owner-attachment-upload-v1');","  const d = b.data;","  pm.expect(d.outcome).to.eql(v('expected_outcome'));","  for (const key of ['parent_type','parent_id','warehouse_id','file_sha256','auth_session_id']) pm.expect(d[key]).to.eql(v(key));","  pm.expect(d.request_key).to.eql(v('operation_key'));","  pm.expect(d.cancel_supported).to.eql(false);","  if (d.outcome === 'UNKNOWN') {","    pm.expect(d.receipt).to.eql(null); pm.expect(d.retry_policy).to.eql('CHECK_ONLY');","    // current_attachment may exist; it cannot prove completion of this request.","  } else {","    pm.expect(d.retry_policy).to.eql('NONE');","    const r = d.receipt;","    pm.expect(r.contract).to.eql('owner-attachment-upload-v1'); pm.expect(r.command).to.eql('UPLOAD');","    pm.expect(r.request_key).to.eql(v('operation_key')); pm.expect(r.outcome).to.eql(d.outcome);","    for (const key of ['actor_id','auth_session_id','warehouse_id','parent_type','parent_id','file_sha256']) pm.expect(r[key]).to.eql(v(key));","    // A REJECTED result may retain a QUARANTINED audit row, not a downloadable file.","    if (d.outcome === 'SUCCEEDED') { pm.expect(r.http_status).to.eql(201); pm.expect(r.attachment_status_at_completion).to.eql('ACTIVE'); }","    if (d.current_attachment) pm.expect(d.current_attachment.attachment_id).to.eql(r.attachment_id);","  }","  if (d.current_attachment) pm.expect(d.current_attachment.owner_download_required).to.eql(true);","  // Never compare historical receipt version/status to current attachment version/status.","});","// Do not persist/log raw responses, PII, filename, cookies or tokens; no follow-up mutation."]}}],"item":[{"name":"P01_ME","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"},{"key":"X-Request-ID","value":"{{p18_read_trace}}"}],"url":"{{api_origin}}/api/v1/auth/me"}},{"name":"INBOUND_LIST","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"},{"key":"X-Request-ID","value":"{{p18_read_trace}}"}],"url":"{{api_origin}}/api/v1/mini-app/inbound-documents/{{parent_id}}/attachments?page=1&per_page=20"}},{"name":"INBOUND_RECONCILE","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"},{"key":"X-Request-ID","value":"{{p18_read_trace}}"}],"url":"{{api_origin}}/api/v1/mini-app/inbound-documents/{{parent_id}}/attachments/requests/{{operation_key}}?warehouse_id={{warehouse_id}}&file_sha256={{file_sha256}}"}},{"name":"OUTBOUND_LIST","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"},{"key":"X-Request-ID","value":"{{p18_read_trace}}"}],"url":"{{api_origin}}/api/v1/mini-app/outbound-documents/{{parent_id}}/attachments?page=1&per_page=20"}},{"name":"OUTBOUND_RECONCILE","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"},{"key":"X-Request-ID","value":"{{p18_read_trace}}"}],"url":"{{api_origin}}/api/v1/mini-app/outbound-documents/{{parent_id}}/attachments/requests/{{operation_key}}?warehouse_id={{warehouse_id}}&file_sha256={{file_sha256}}"}},{"name":"WARRANTY_LIST","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"},{"key":"X-Request-ID","value":"{{p18_read_trace}}"}],"url":"{{api_origin}}/api/v1/mini-app/warranty-cases/{{parent_id}}/attachments?warehouse_id={{warehouse_id}}&page=1&per_page=20"}},{"name":"WARRANTY_RECONCILE","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"},{"key":"X-Request-ID","value":"{{p18_read_trace}}"}],"url":"{{api_origin}}/api/v1/mini-app/warranty-cases/{{parent_id}}/attachments/requests/{{operation_key}}?warehouse_id={{warehouse_id}}&file_sha256={{file_sha256}}"}}]}
