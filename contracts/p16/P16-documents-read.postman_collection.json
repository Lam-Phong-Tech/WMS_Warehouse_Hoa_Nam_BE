{
  "info": {
    "name": "P16 - Owner document reads (auth + 3 lists)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "SOURCE_SMOKE_FOR_APPROVED_AGGREGATE. Four GET requests: auth/me and the three canonical owner lists. The All tab uses GET /api/v1/mini-app/documents under contracts/p12-p13-p16/all-documents-v1.json; FE must not merge these source pages. Read contracts/p16/owner-read-v1.json. Select exactly one read_id. Use only independently approved owner/environment access and original trusted context. filters_json contains supported filters only; warehouse_id is supplied separately from verified auth context. Expected total and error.code must be supplied from the authorized test case. No scripts login, refresh, contact, create records, store responses or chain requests. Keep credentials only in a private local environment; never export/sync tokens, cookies or raw PII. Redirects disabled. Needs a runtime supporting pm.execution.skipRequest; no unverified Newman compatibility claim. Script skips and a green collection alone are NOT live acceptance."
  },
  "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{access_token}}","type":"string"}]},
  "protocolProfileBehavior": {"followRedirects":false},
  "variable": [
    {"key":"api_origin","value":""},{"key":"approved_api_origin","value":""},{"key":"read_id","value":""},
    {"key":"actor_id","value":""},{"key":"auth_session_id","value":""},{"key":"current_auth_session_id","value":""},
    {"key":"warehouse_id","value":""},{"key":"expected_http_status","value":""},{"key":"expected_error_code","value":""},
    {"key":"expected_total","value":""},{"key":"filters_json","value":"{}"},
    {"key":"live_read_authorized","value":"false"},{"key":"owner_gate_authorized","value":"false"}
  ],
  "event": [
    {"listen":"prerequest","script":{"type":"text/javascript","exec":[
      "(() => {",
      "  const id = pm.info.requestName;",
      "  const v = key => String(pm.variables.get(key) ?? '');",
      "  const stop = () => { pm.execution.skipRequest(); throw new Error('P16 GET blocked: check approved owner, environment, scope and supported query.'); };",
      "  if (v('read_id') !== id) { pm.execution.skipRequest(); return; }",
      "  const specs = {P01_AUTH_ME:{path:'/api/v1/auth/me',kind:'AUTH_CONTEXT',query:[]},P12_INBOUND_LIST:{path:'/api/v1/mini-app/inbound-documents',kind:'DOCUMENT_SOURCE',query:['warehouse_id','keyword','status','date_from','date_to','timezone','sort_order','page','per_page'],per_page_max:200,statuses:['DRAFT','SCANNING','POSTED','CANCELLED'],status_aliases:{WAITING_APPROVAL:'SCANNING plus readiness'},sort_query:'sort_order',sort_values:['asc','desc']},P12_OUTBOUND_LIST:{path:'/api/v1/mini-app/outbound-documents',kind:'DOCUMENT_SOURCE',query:['warehouse_id','keyword','status','date_from','date_to','timezone','sort_order','page','per_page'],per_page_max:200,statuses:['DRAFT','SCANNING','POSTED','CANCELLED'],sort_query:'sort_order',sort_values:['asc','desc']},P09_WARRANTY_LIST:{path:'/api/v1/mini-app/warranty-cases',kind:'DOCUMENT_SOURCE',query:['warehouse_id','search','status','sort','cursor','page','per_page'],per_page_max:100,statuses:['RECEIVED','CHECKING','REPAIRING','COMPLETED','RETURNED','CANCELLED'],status_all:'ALL',sort_query:'sort',sort_values:['created_at_desc','created_at_asc']}};",
      "  const spec = specs[id];",
      "  if (!spec || pm.request.method !== 'GET' || pm.request.body) stop();",
      "  if (v('live_read_authorized') !== 'true' || v('owner_gate_authorized') !== 'true') stop();",
      "  const origin = v('api_origin');",
      "  if (!(new RegExp('^https://[a-z0-9.-]+(?::[0-9]+)?$', 'i')).test(origin) || origin !== v('approved_api_origin')) stop();",
      "  if (!v('access_token') || !['200','401','403','404','409','422','500','503'].includes(v('expected_http_status'))) stop();",
      "  if (v('expected_http_status') !== '200' && !v('expected_error_code')) stop();",
      "  const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;",
      "  if (!uuid.test(v('actor_id')) || !uuid.test(v('auth_session_id')) || v('auth_session_id') !== v('current_auth_session_id')) stop();",
      "  let filters; try { filters = JSON.parse(v('filters_json') || '{}'); } catch (_) { stop(); }",
      "  if (!filters || typeof filters !== 'object' || Array.isArray(filters)) stop();",
      "  if (Object.keys(filters).some(k => !spec.query.includes(k) || k === 'warehouse_id')) stop();",
      "  const query = {...filters};",
      "  if (spec.kind === 'DOCUMENT_SOURCE') {",
      "    if (!uuid.test(v('warehouse_id'))) stop();",
      "    query.warehouse_id = v('warehouse_id');",
      "    if (v('expected_http_status') === '200' && !/^(0|[1-9][0-9]*)$/.test(v('expected_total'))) stop();",
      "    if (v('expected_total') && !Number.isSafeInteger(Number(v('expected_total')))) stop();",
      "  }",
      "  for (const key of ['keyword','search','cursor']) if (key in query && (typeof query[key] !== 'string' || query[key].length > (key === 'cursor' ? 4096 : 200) || (key === 'cursor' && !query[key]))) stop();",
      "  if ('page' in query && (!Number.isSafeInteger(query.page) || query.page < 1 || query.page > 100000)) stop();",
      "  if ('per_page' in query && (!Number.isSafeInteger(query.per_page) || query.per_page < 1 || query.per_page > spec.per_page_max)) stop();",
      "  if ('page' in query && 'cursor' in query) stop();",
      "  if ('status' in query && ![...(spec.statuses || []), ...(spec.status_all ? [spec.status_all] : []), ...Object.keys(spec.status_aliases || {})].includes(query.status)) stop();",
      "  if (spec.sort_query in query && !spec.sort_values.includes(query[spec.sort_query])) stop();",
      "  const validDate = value => typeof value === 'string' && /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(value) && !Number.isNaN(Date.parse(value + 'T00:00:00Z')) && new Date(value + 'T00:00:00Z').toISOString().slice(0,10) === value;",
      "  for (const key of ['date_from','date_to']) if (key in query && !validDate(query[key])) stop();",
      "  if (query.date_from && query.date_to && query.date_from > query.date_to) stop();",
      "  // This collection deliberately fixes the UI timezone; owner P12 can support others.",
      "  if ('timezone' in query && query.timezone !== 'Asia/Ho_Chi_Minh') stop();",
      "  const template = '{{api_origin}}' + spec.path + '{{p16_query}}';",
      "  if (pm.request.url.toString() !== template) stop();",
      "  const encoded = Object.entries(query).map(([k,value]) => encodeURIComponent(k) + '=' + encodeURIComponent(String(value))).join('&');",
      "  pm.variables.set('p16_query', encoded ? '?' + encoded : '');",
      "  const trace = pm.variables.replaceIn('{{$guid}}'); if (!uuid.test(trace)) stop();",
      "  pm.variables.set('p16_trace', trace);",
      "  pm.variables.set('p16_effective_query', JSON.stringify(query));",
      "  if (pm.variables.replaceIn(pm.request.url.toString()) !== origin + spec.path + (encoded ? '?' + encoded : '')) stop();",
      "})();"
    ]}},
    {"listen":"test","script":{"type":"text/javascript","exec":[
      "const v = key => String(pm.variables.get(key) ?? '');",
      "const id = pm.info.requestName;",
      "const specs = {P01_AUTH_ME:{kind:'AUTH_CONTEXT'},P12_INBOUND_LIST:{owner:'P12',kind:'DOCUMENT_SOURCE',id_field:'id',warehouse_field:'dst_warehouse_id',statuses:['DRAFT','SCANNING','POSTED','CANCELLED']},P12_OUTBOUND_LIST:{owner:'P12',kind:'DOCUMENT_SOURCE',id_field:'id',warehouse_field:'src_warehouse_id',statuses:['DRAFT','SCANNING','POSTED','CANCELLED']},P09_WARRANTY_LIST:{owner:'P09',kind:'DOCUMENT_SOURCE',id_field:'warranty_case_id',warehouse_field:'warehouse_id',statuses:['RECEIVED','CHECKING','REPAIRING','COMPLETED','RETURNED','CANCELLED']}};",
      "const spec = specs[id];",
      "pm.test('Exact expected HTTP status', () => pm.expect(pm.response.code).to.eql(Number(v('expected_http_status'))));",
      "pm.test('Owner JSON and trace; not inferred from proxy or health', () => {",
      "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
      "  const body = pm.response.json(); pm.expect(body).to.be.an('object');",
      "  pm.expect(body.meta.request_id).to.eql(v('p16_trace'));",
      "  if (pm.response.code !== 200) { pm.expect(body.success).to.eql(false); pm.expect(body.error.code).to.eql(v('expected_error_code')); return; }",
      "  pm.expect(body.success).to.eql(true);",
      "  if (spec.kind !== 'DOCUMENT_SOURCE') { pm.expect(body.data).to.be.an('object'); return; }",
      "  pm.expect(body.data).to.be.an('array');",
      "  pm.expect(Number.isSafeInteger(body.meta.total) && body.meta.total >= 0).to.eql(true);",
      "  pm.expect(body.meta.total).to.eql(Number(v('expected_total')));",
      "  pm.expect(body.data.length <= body.meta.total && body.data.length <= body.meta.per_page).to.eql(true);",
      "  const e = body.meta.count_evidence;",
      "  pm.expect(e.contract).to.eql('authorized-source-count-v1');",
      "  pm.expect(e.scope).to.eql('CURRENT_AUTHORIZED_ENDPOINT_QUERY');",
      "  pm.expect(e.filtered_total).to.eql(body.meta.total);",
      "  pm.expect(e.all_sources_aggregate).to.eql(false); pm.expect(e.cross_request_snapshot).to.eql(false);",
      "  const query = JSON.parse(v('p16_effective_query'));",
      "  const transport = spec.owner === 'P12' ? ['warehouse_id','page','per_page','sort_order','timezone'] : ['warehouse_id','page','per_page','cursor','sort'];",
      "  const unfiltered = Object.entries(query).every(([k,value]) => transport.includes(k) || (spec.owner === 'P09' && k === 'status' && value === 'ALL') || value === null || (typeof value === 'string' && !value.trim()));",
      "  pm.expect(e.unfiltered_request).to.eql(unfiltered);",
      "  pm.expect(e.unfiltered_authorized_total).to.eql(unfiltered ? body.meta.total : null);",
      "  pm.expect(e.source_empty).to.eql(unfiltered ? body.meta.total === 0 : null);",
      "  for (const row of body.data) {",
      "    pm.expect(row[spec.id_field]).to.match(/^[0-9a-f-]{36}$/);",
      "    pm.expect(row[spec.warehouse_field]).to.eql(v('warehouse_id'));",
      "    pm.expect(spec.statuses).to.include(row.status);",
      "    pm.expect(row).to.have.property('created_at');",
      "  }",
      "  if (spec.owner === 'P12') { pm.expect(body.meta.read_contract.all_sources_aggregate).to.eql(false); pm.expect(body.meta.read_contract.date_field).to.eql('created_at'); }",
      "  else { pm.expect(body.meta.contract).to.eql('mini-app-p09-v1'); pm.expect(body.meta.scope_policy).to.eql('PERSISTED_WARRANTY_OWNER_BEFORE_TOTAL'); }",
      "});"
    ]}}
  ],
  "item": [
    {"name":"P01_AUTH_ME","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"},{"key":"X-Request-ID","value":"{{p16_trace}}"}],"url":"{{api_origin}}/api/v1/auth/me{{p16_query}}"}},
    {"name":"P12_INBOUND_LIST","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"},{"key":"X-Request-ID","value":"{{p16_trace}}"}],"url":"{{api_origin}}/api/v1/mini-app/inbound-documents{{p16_query}}"}},
    {"name":"P12_OUTBOUND_LIST","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"},{"key":"X-Request-ID","value":"{{p16_trace}}"}],"url":"{{api_origin}}/api/v1/mini-app/outbound-documents{{p16_query}}"}},
    {"name":"P09_WARRANTY_LIST","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"},{"key":"X-Request-ID","value":"{{p16_trace}}"}],"url":"{{api_origin}}/api/v1/mini-app/warranty-cases{{p16_query}}"}}
  ]
}
